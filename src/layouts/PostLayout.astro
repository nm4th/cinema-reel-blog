---
import Layout from './Layout.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  tags?: string[];
  heroImage?: string;
  heroVideoId?: string;
}

const { title, description, pubDate, updatedDate, category, tags = [], heroImage, heroVideoId } = Astro.props;

// If heroImage is set, use it. Otherwise, if heroVideoId is set (上映ガイド系
// articles that embed an official trailer), pull the video's high-resolution
// poster frame from YouTube's public CDN. Otherwise, no hero image (the
// post-hero block falls back to its bg-deep color with just the title).
const heroBackground =
  heroImage ?? (heroVideoId ? `https://img.youtube.com/vi/${heroVideoId}/maxresdefault.jpg` : undefined);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' }).format(d);

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'ブログ', url: '/blog/' },
  { name: category, url: `/blog/category/${encodeURIComponent(category)}/` },
  { name: title, url: Astro.url.pathname },
];

// Hub backlinks: if the article is tagged for a platform that has a
// pillar/hub page (currently just Netflix), surface a small chip near
// the post title that links back to the hub. Strengthens the
// hub→spoke→hub internal link cycle for SEO.
const tagsLower = (tags ?? []).map((t) => t.toLowerCase());
const hubLinks: Array<{ label: string; href: string }> = [];
if (tagsLower.includes('netflix')) {
  hubLinks.push({ label: 'Netflix 特集を見る →', href: '/netflix/' });
}
---
<Layout
  title={`${title}｜CINEMA REEL 新宿`}
  description={description}
  ogImage={heroBackground}
  bodyClass="post-body"
  article={{ pubDate, updatedDate, section: category, tags }}
  breadcrumbs={breadcrumbs}
>
  <article class="post">
    <div class="post-hero" style={heroBackground ? `background-image: url('${heroBackground}');` : ''}>
      <div class="post-hero-overlay">
        <div class="container">
          <p class="post-meta-top">
            <span class="reel-section-num">{category}</span>
          </p>
          <h1 class="post-title">{title}</h1>
          <p class="post-meta">
            <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
            {updatedDate && (
              <span class="post-meta-sep">/ 更新 <time datetime={updatedDate.toISOString()}>{fmt(updatedDate)}</time></span>
            )}
          </p>
        </div>
      </div>
    </div>

    <div class="container post-grid">
      <div class="post-content">
        {hubLinks.length > 0 && (
          <nav class="post-hub-links" aria-label="関連特集">
            {hubLinks.map((h) => (
              <a class="post-hub-chip" href={h.href}>{h.label}</a>
            ))}
          </nav>
        )}
        <slot />

        {tags.length > 0 && (
          <div class="post-tags" aria-label="タグ">
            {tags.map((t) => <span class="post-tag">#{t}</span>)}
          </div>
        )}

        <aside class="post-cta">
          <p class="post-cta-lead">新宿で大画面で観るなら</p>
          <p class="post-cta-sub">CINEMA REEL 新宿は新宿駅徒歩2分、最大6名の完全貸切プライベートシネマ。EPSON 4Kプロジェクターで Netflix・Prime・U-NEXT・Disney+・Abema をログイン済みの状態で大画面に。</p>
          <a class="post-cta-btn" href="/">
            詳細を見る
          </a>
        </aside>
      </div>

      <aside class="post-side">
        <div class="post-side-card">
          <h3>CINEMA REEL 新宿</h3>
          <ul>
            <li>新宿駅徒歩2分・大江戸線新宿西口駅徒歩1分</li>
            <li>EPSON 4Kプロジェクター + 大型スクリーン</li>
            <li>Netflix / Prime / U-NEXT / Disney+ / Abema 視聴可</li>
            <li>最大6名・約19㎡（12畳）</li>
            <li>営業時間 7:00 – 23:00</li>
          </ul>
          <a class="post-side-link" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
            空き状況を確認 →
          </a>
        </div>

        <div class="post-side-card subtle">
          <h3>ブログ一覧</h3>
          <p><a href="/blog/">記事一覧へ →</a></p>
        </div>
      </aside>
    </div>
  </article>

  <style>
    .post-body { background: var(--bg); }

    .post-hero {
      min-height: 360px;
      background-size: cover;
      background-position: center;
      background-color: var(--bg-deep);
      position: relative;
      border-bottom: 1px solid var(--film-edge);
    }
    .post-hero-overlay {
      min-height: 360px;
      display: flex;
      align-items: flex-end;
      background: linear-gradient(180deg, rgba(5,4,3,0.55) 0%, rgba(5,4,3,0.92) 100%);
      padding: 60px 0 40px;
    }
    .post-meta-top { margin: 0 0 16px; }
    .post-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.7rem, 4vw, 2.6rem);
      color: var(--ink);
      margin: 0;
      line-height: 1.4;
      max-width: 920px;
    }
    .post-meta {
      margin: 18px 0 0;
      font-family: var(--font-aux);
      letter-spacing: 0.18em;
      color: var(--ink-muted);
      font-size: 0.85rem;
    }
    .post-meta-sep { margin-left: 10px; }

    .post-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 280px;
      gap: 56px;
      padding-top: 56px;
      padding-bottom: 80px;
    }
    @media (max-width: 900px) {
      .post-grid { grid-template-columns: 1fr; gap: 40px; }
    }

    .post-content :global(p) {
      font-family: var(--font-jp);
      color: #ece1cb;
      font-size: 1.02rem;
      line-height: 2;
      letter-spacing: 0.04em;
      margin: 0 0 1.6em;
    }
    .post-content :global(h2) {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 1.45rem;
      color: var(--gold-bright);
      margin: 2.4em 0 0.9em;
      padding-bottom: 0.4em;
      border-bottom: 1px solid var(--film-edge);
      letter-spacing: 0.05em;
    }
    .post-content :global(h3) {
      font-family: var(--font-jp);
      font-weight: 600;
      font-size: 1.18rem;
      color: var(--ink);
      margin: 2em 0 0.7em;
      letter-spacing: 0.04em;
    }
    .post-content :global(ul),
    .post-content :global(ol) {
      padding-left: 1.4em;
      margin: 0 0 1.6em;
      color: #ece1cb;
    }
    .post-content :global(li) {
      margin-bottom: 0.5em;
      line-height: 1.9;
    }
    /* Inline article links use gold-bright with a dashed underline.
       The `:not(.post-cta-btn)` exclusion keeps the bottom gold pill
       readable; the inline mid-article CTA below has its own more-specific
       rules later in the file that override these. */
    .post-content :global(a:not(.post-cta-btn)) {
      color: var(--gold-bright);
      border-bottom: 1px dashed var(--gold);
    }
    .post-content :global(a:not(.post-cta-btn):hover) {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }

    /* Inline mid-article CTA — slimmer than the bottom .post-cta block,
       designed to sit between H2 sections without breaking reading flow.
       Authors drop <aside class="post-cta-inline"> in Markdown directly. */
    .post-content :global(.post-cta-inline) {
      margin: 2.6em 0;
      padding: 22px 26px;
      border: 1px solid var(--gold);
      background: linear-gradient(180deg, rgba(201,169,97,0.06), transparent);
      border-radius: var(--radius);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      align-items: center;
    }
    .post-content :global(.post-cta-inline p) {
      margin: 0 !important;
      font-family: var(--font-jp);
      color: var(--ink) !important;
      font-size: 0.92rem !important;
      line-height: 1.85 !important;
      letter-spacing: 0.04em;
    }
    .post-content :global(.post-cta-inline strong) {
      color: var(--gold-bright);
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .post-content :global(.post-cta-inline a) {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 12px 22px;
      background: var(--gold);
      color: var(--bg-deep);
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.16em;
      font-size: 0.88rem;
      white-space: nowrap;
      border: 0;
      transition: background 0.3s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.4s var(--ease-luxe);
      box-shadow: 0 0 0 0 rgba(232,200,120,0);
    }
    .post-content :global(.post-cta-inline a:hover) {
      background: var(--gold-bright);
      color: var(--bg-deep);
      transform: translateY(-2px);
      box-shadow: 0 8px 22px -8px rgba(232,200,120,0.55);
    }
    @media (max-width: 600px) {
      .post-content :global(.post-cta-inline) {
        grid-template-columns: 1fr;
        text-align: center;
        padding: 20px 18px;
      }
      .post-content :global(.post-cta-inline a) {
        justify-self: center;
      }
    }
    .post-content :global(blockquote) {
      border-left: 3px solid var(--gold);
      padding: 0.6em 1.2em;
      margin: 1.6em 0;
      color: var(--ink-muted);
      background: rgba(201,169,97,0.04);
      font-style: italic;
    }
    .post-content :global(strong) { color: var(--gold-bright); font-weight: 600; }
    .post-content :global(img) {
      border-radius: var(--radius);
      margin: 1.2em 0;
      border: 1px solid var(--film-edge);
    }
    .post-content :global(figure) {
      margin: 2em 0;
      padding: 0;
    }
    .post-content :global(figure img) {
      width: 100%;
      display: block;
      margin: 0;
    }
    .post-content :global(figcaption) {
      margin-top: 12px;
      font-family: var(--font-aux);
      font-style: italic;
      font-size: 0.85rem;
      color: var(--ink-muted);
      text-align: center;
      letter-spacing: 0.06em;
      line-height: 1.6;
    }
    .post-content :global(.video-embed) {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      margin: 2em 0;
      background: var(--bg-deep);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
    }
    .post-content :global(.video-embed iframe) {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      border: 0;
    }
    .post-content :global(.source-list) {
      margin: 1.6em 0;
      padding: 18px 22px;
      border: 1px dashed var(--film-edge);
      background: rgba(20, 17, 13, 0.5);
      border-radius: var(--radius);
      font-size: 0.9rem;
    }
    .post-content :global(.source-list-title) {
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.16em;
      color: var(--gold);
      margin: 0 0 10px;
      font-size: 0.85rem;
    }
    .post-content :global(.source-list ul) {
      margin: 0;
      padding-left: 1.2em;
    }
    .post-content :global(table) {
      width: 100%;
      border-collapse: collapse;
      margin: 1.4em 0;
      font-size: 0.95rem;
    }
    .post-content :global(th),
    .post-content :global(td) {
      border: 1px solid var(--film-edge);
      padding: 10px 14px;
      text-align: left;
    }
    .post-content :global(th) {
      background: var(--bg-card);
      color: var(--gold-bright);
      font-weight: 600;
    }

    .post-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 32px 0 0;
      padding-top: 24px;
      border-top: 1px dashed var(--film-edge);
    }
    .post-tag {
      font-family: var(--font-aux);
      font-size: 0.85rem;
      color: var(--ink-muted);
      letter-spacing: 0.1em;
    }

    .post-cta {
      margin: 56px 0 0;
      padding: 36px 32px;
      border: 1px solid var(--gold);
      background: linear-gradient(180deg, rgba(201,169,97,0.05), transparent);
      border-radius: var(--radius);
      text-align: center;
    }
    .post-cta-lead {
      margin: 0 0 12px;
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.4rem;
      color: var(--gold-bright);
      letter-spacing: 0.08em;
    }
    .post-cta-sub {
      margin: 0 0 22px;
      color: var(--ink-muted);
      font-size: 0.95rem;
      line-height: 1.8;
    }
    .post-cta-btn {
      display: inline-block;
      padding: 14px 38px;
      background: var(--gold);
      color: var(--bg-deep);
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.18em;
      font-size: 0.95rem;
      transition: background 0.25s ease;
    }
    .post-cta-btn:hover { background: var(--gold-bright); color: var(--bg-deep); }

    /* Hub backlinks (SEO topic-cluster) — chip-style links near the
       top of the article body, pointing to a pillar page. Only renders
       when the post matches a hub. */
    .post-hub-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 0 0 32px;
    }
    .post-hub-chip {
      display: inline-flex;
      align-items: center;
      padding: 8px 16px;
      border: 1px solid var(--gold);
      color: var(--gold-bright);
      font-family: var(--font-display);
      font-style: italic;
      font-size: 0.82rem;
      letter-spacing: 0.12em;
      border-radius: 999px;
      transition: background 0.3s var(--ease-luxe), color 0.3s var(--ease-luxe), transform 0.4s var(--ease-luxe);
    }
    .post-hub-chip:hover {
      background: var(--gold);
      color: var(--bg-deep);
      transform: translateY(-1px);
    }

    .post-side { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 96px; align-self: start; }
    .post-side-card {
      padding: 24px 22px;
      border: 1px solid var(--film-edge);
      background: var(--bg-card);
      border-radius: var(--radius);
    }
    .post-side-card h3 {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.05rem;
      letter-spacing: 0.12em;
      color: var(--gold);
      margin: 0 0 14px;
    }
    .post-side-card ul {
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .post-side-card li {
      font-size: 0.85rem;
      line-height: 1.7;
      color: var(--ink-muted);
      padding-left: 14px;
      position: relative;
    }
    .post-side-card li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--gold);
    }
    .post-side-link {
      display: inline-block;
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.1em;
      color: var(--gold-bright);
      font-size: 0.9rem;
    }
    .post-side-card.subtle { background: transparent; }
  </style>
</Layout>
