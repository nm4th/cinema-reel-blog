---
/**
 * Netflix Watch Hub — pillar page in the topic-cluster SEO model.
 *
 * Fixed URL (`/netflix/`), but the spoke grid below is queried at build
 * time from the content collection: any post tagged "Netflix" appears
 * here automatically. Add a new spoke article → next deploy refreshes
 * this hub. Remove a spoke → it disappears from the hub. Zero manual
 * curation, which is the management model the user asked for.
 *
 * Conversion design: every viewer of this page should be one click
 * away from the Spacemarket booking page (sticky CTA + hero CTA), and
 * one click away from a relevant in-depth spoke article.
 */
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { resolvePostThumbnail } from '../lib/post.ts';

const posts = (await getCollection('posts', ({ data }) =>
  !data.draft && data.tags.some((t) => t.toLowerCase() === 'netflix')
)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

// Group posts by sub-type tag for sectioning. Any post not matching
// these classifications still appears in 「最新の話題作」 below.
const liveTagged = posts.filter((p) =>
  p.data.tags.some((t) => /^(配信ライブ|ライブ配信|生中継|PPV)/i.test(t))
);
const liveSlugs = new Set(liveTagged.map((p) => p.slug));
const otherPosts = posts.filter((p) => !liveSlugs.has(p.slug));

const breadcrumbs = [
  { name: 'ホーム', url: '/' },
  { name: 'Netflix で観る', url: '/netflix/' },
];

const collectionItems = posts.map((p) => ({
  url: `/blog/${p.slug}/`,
  name: p.data.title,
  description: p.data.description,
  image: resolvePostThumbnail(p.data) ?? undefined,
}));

const heroBg = posts[0] ? resolvePostThumbnail(posts[0].data) : null;
---
<Layout
  title="Netflix の話題作を新宿の大画面で観るなら｜CINEMA REEL 新宿"
  description="Netflix Japan で配信中・配信開始予定の話題作を、新宿駅徒歩2分・最大6名の完全貸切プライベートシネマ「CINEMA REEL 新宿」で観るためのガイド集。ドラマ・映画・配信ライブの一次情報を、作品ごとにまとめています。"
  ogImage={heroBg ?? undefined}
  breadcrumbs={breadcrumbs}
  collectionPage={{
    name: 'Netflix 話題作 視聴ガイド集 — CINEMA REEL 新宿',
    description:
      'Netflix Japan の話題作を新宿の大画面で観るためのガイド集。ドラマ・映画・配信ライブを作品単位で紹介。',
    items: collectionItems,
  }}
>
  <!-- HERO -->
  <section class="nf-hero">
    {heroBg && (
      <div class="nf-hero-bg" style={`background-image: url('${heroBg}');`}></div>
    )}
    <div class="nf-hero-tint"></div>
    <div class="container nf-hero-inner">
      <p class="reel-section-num">— Netflix Watch Hub</p>
      <h1 class="nf-hero-title">
        <span class="nf-hero-title-en italic">Netflix</span>
        <span class="nf-hero-title-jp">の話題作を、<br />新宿の大画面で。</span>
      </h1>
      <p class="nf-hero-lead">
        Netflix Japan の最新ドラマ・映画・配信ライブを、新宿駅徒歩2分の<strong>完全貸切プライベートシネマ</strong>「CINEMA REEL 新宿」で観るための作品別ガイド集。EPSON 4Kプロジェクター・最大6名・ログイン済みの状態で、来店してすぐ第1話から再生できます。
      </p>
      <div class="nf-hero-cta">
        <a class="btn btn-primary" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
          空き状況・予約
        </a>
        <a class="btn btn-ghost" href="/#booking-flow">予約方法を見る</a>
      </div>
      <p class="nf-hero-meta">
        <span class="hero-meta-star">★</span> 4.6 / 5.0 (43件)
        <span class="dot">·</span> 最大6名 · 約19㎡
        <span class="dot">·</span> 7:00 – 23:00
      </p>
    </div>
  </section>

  <!-- VALUE PROP -->
  <section class="section reveal-up">
    <div class="container">
      <div class="nf-intro">
        <h2 class="nf-section-title">
          ご来店してすぐ、Netflix が大画面に。
        </h2>
        <p>
          CINEMA REEL 新宿は、Netflix・Prime Video・U-NEXT・Disney+・Abema を <strong>店舗側でログイン済み</strong> の状態で運営しています。ゲストがアカウント情報を入力する必要なく、来店後すぐにリモコンで観たい作品を選んで再生できる構成です。
        </p>
        <p>
          以下は、Netflix Japan で話題になっている作品ごとに、配信日・キャスト・公式予告編・大画面で観るための段取りをまとめたガイド集。気になる作品をクリックすると、その作品を観るための一次情報がまとまったページに移動します。
        </p>
      </div>
    </div>
  </section>

  <!-- LIVE BROADCAST GROUP -->
  {liveTagged.length > 0 && (
    <section class="section reveal-up">
      <div class="container">
        <div class="nf-group-head">
          <span class="reel-section-num">— Live</span>
          <h2 class="nf-section-title">配信ライブ・PPV</h2>
          <p class="nf-section-sub">
            Netflix が独占配信する生中継・PPV イベント。早朝・深夜の時間帯でも、貸切で大画面で観戦できる選択肢として。
          </p>
        </div>
        <div class="nf-grid stagger reveal-up">
          {liveTagged.map((post) => {
            const thumb = resolvePostThumbnail(post.data);
            return (
              <a class="nf-card" href={`/blog/${post.slug}/`}>
                <div class="nf-card-thumb" style={thumb ? `background-image: url('${thumb}');` : ''}></div>
                <div class="nf-card-body">
                  <p class="nf-card-meta">
                    <span class="cat">{post.data.category}</span>
                    <span class="dot">·</span>
                    <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  </p>
                  <h3 class="nf-card-title">{post.data.title}</h3>
                  <p class="nf-card-desc">{post.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- INLINE CTA -->
  <section class="section nf-inline-cta-wrap">
    <div class="container">
      <aside class="post-cta-inline" style="max-width: 880px; margin: 0 auto;">
        <p>
          <strong>CINEMA REEL 新宿</strong>では Netflix・Prime Video・U-NEXT・Disney+・Abema が店舗側でログイン済み。来店してすぐ、観たい作品を大画面で再生できます。
        </p>
        <a href="/">詳細を見る →</a>
      </aside>
    </div>
  </section>

  <!-- LATEST DRAMAS / MOVIES -->
  {otherPosts.length > 0 && (
    <section class="section reveal-up">
      <div class="container">
        <div class="nf-group-head">
          <span class="reel-section-num">— Latest</span>
          <h2 class="nf-section-title">最新の話題作・トレンド</h2>
          <p class="nf-section-sub">
            Netflix Japan で配信開始日が確定している話題作、または現在ランキング上位の作品。
          </p>
        </div>
        <div class="nf-grid stagger reveal-up">
          {otherPosts.map((post) => {
            const thumb = resolvePostThumbnail(post.data);
            return (
              <a class="nf-card" href={`/blog/${post.slug}/`}>
                <div class="nf-card-thumb" style={thumb ? `background-image: url('${thumb}');` : ''}></div>
                <div class="nf-card-body">
                  <p class="nf-card-meta">
                    <span class="cat">{post.data.category}</span>
                    <span class="dot">·</span>
                    <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                  </p>
                  <h3 class="nf-card-title">{post.data.title}</h3>
                  <p class="nf-card-desc">{post.data.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {posts.length === 0 && (
    <section class="section">
      <div class="container">
        <p class="nf-empty">作品ガイドを準備中です。配信日が確定した話題作から順に追加していきます。</p>
      </div>
    </section>
  )}

  <!-- BOOKING CTA SECTION -->
  <section class="section section-dark reveal-up">
    <div class="container nf-final-cta">
      <p class="reel-section-num">— Book Your Cinema</p>
      <h2 class="nf-section-title">作品が決まったら、新宿で大画面に。</h2>
      <p class="nf-final-lead">
        新宿駅西口徒歩2分の完全貸切プライベートシネマ <strong>CINEMA REEL 新宿</strong>。
        最大6名・EPSON 4Kプロジェクター・ふかふかのソファ・主要 VOD ログイン済みで、
        観たい作品をすぐ大画面で再生できます。
      </p>
      <div class="nf-final-cta-row">
        <a class="btn btn-primary" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
          空き状況・予約
        </a>
        <a class="btn btn-ghost" href="/#booking-flow">予約方法を見る</a>
      </div>
    </div>
  </section>

  <style>
    .nf-hero {
      position: relative;
      min-height: 64vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--film-edge);
    }
    .nf-hero-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: brightness(0.32) saturate(0.85);
      transform: scale(1.05);
    }
    .nf-hero-tint {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(5,4,3,0.45) 0%, rgba(5,4,3,0.92) 100%),
        radial-gradient(ellipse at 30% 30%, rgba(229,9,20,0.12), transparent 60%),
        radial-gradient(ellipse at 80% 80%, rgba(201,169,97,0.10), transparent 60%);
    }
    .nf-hero-inner {
      position: relative;
      z-index: 2;
      padding: 96px 0 72px;
    }
    .nf-hero-title {
      display: flex;
      flex-direction: column;
      gap: 18px;
      margin: 14px 0 24px;
      line-height: 1;
    }
    .nf-hero-title-en {
      font-family: var(--font-display);
      font-style: italic;
      font-weight: 600;
      font-size: clamp(3rem, 8vw, 5.6rem);
      letter-spacing: 0.04em;
      color: var(--gold-bright);
    }
    .nf-hero-title-jp {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.6rem, 3vw, 2.4rem);
      letter-spacing: 0.06em;
      line-height: 1.5;
      color: var(--ink);
    }
    .nf-hero-lead {
      max-width: 640px;
      color: var(--ink);
      line-height: 2;
      margin: 0 0 32px;
    }
    .nf-hero-cta {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 32px;
    }
    .nf-hero-meta {
      margin: 0;
      color: var(--ink-muted);
      font-family: var(--font-aux);
      letter-spacing: 0.16em;
      font-size: 0.85rem;
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }
    .nf-hero-meta .dot { color: var(--ink-dim); }
    .hero-meta-star { color: var(--gold-bright); }

    @media (max-width: 600px) {
      .nf-hero { min-height: auto; }
      .nf-hero-inner { padding: 60px 0 56px; }
      .nf-hero-cta .btn { flex: 1 1 0; min-width: 0; padding: 12px 16px; font-size: 0.85rem; letter-spacing: 0.1em; }
    }

    .nf-intro {
      max-width: 760px;
      margin: 0 auto;
    }
    .nf-section-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.5rem, 3vw, 2rem);
      color: var(--ink);
      letter-spacing: 0.04em;
      line-height: 1.5;
      margin: 12px 0 18px;
    }
    .nf-intro p {
      color: #ece1cb;
      line-height: 2;
      margin: 0 0 1.5em;
    }
    .nf-intro strong { color: var(--gold-bright); font-weight: 600; }

    .nf-group-head { margin-bottom: 40px; }
    .nf-section-sub {
      color: var(--ink-muted);
      max-width: 720px;
      margin: 0;
      line-height: 1.9;
    }

    .nf-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 28px;
      margin-top: 40px;
    }
    @media (max-width: 700px) {
      .nf-grid { grid-template-columns: 1fr; gap: 20px; }
    }

    .nf-card {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.5s var(--ease-luxe);
      box-shadow: 0 4px 16px -8px rgba(0,0,0,0.6);
    }
    .nf-card:hover {
      border-color: var(--gold);
      transform: translateY(-3px);
      box-shadow: 0 18px 48px -16px rgba(201,169,97,0.25);
    }
    .nf-card-thumb {
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
      background-color: var(--bg-deep);
      border-bottom: 1px solid var(--film-edge);
      transition: transform 0.8s var(--ease-luxe), filter 0.5s var(--ease-luxe);
      filter: brightness(0.88) saturate(0.92);
    }
    .nf-card:hover .nf-card-thumb {
      transform: scale(1.04);
      filter: brightness(1) saturate(1.05);
    }
    .nf-card-body { padding: 26px 26px 28px; flex: 1; display: flex; flex-direction: column; }
    .nf-card-meta {
      font-family: var(--font-aux);
      letter-spacing: 0.16em;
      color: var(--ink-muted);
      font-size: 0.78rem;
      margin: 0 0 14px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .nf-card-meta .cat { color: var(--gold); }
    .nf-card-meta .dot { color: var(--ink-dim); }
    .nf-card-title {
      font-family: var(--font-jp);
      font-weight: 700;
      color: var(--ink);
      font-size: 1.08rem;
      line-height: 1.55;
      margin: 0 0 12px;
      letter-spacing: 0.04em;
      transition: color 0.3s var(--ease-luxe);
    }
    .nf-card:hover .nf-card-title { color: var(--gold-bright); }
    .nf-card-desc {
      color: var(--ink-muted);
      font-size: 0.9rem;
      line-height: 1.85;
      margin: 0;
    }

    .nf-empty {
      color: var(--ink-muted);
      text-align: center;
      padding: 60px 0;
    }

    .nf-inline-cta-wrap { padding: 32px 0; }
    .nf-inline-cta-wrap :global(.post-cta-inline) {
      margin: 0 auto;
      padding: 22px 26px;
      border: 1px solid var(--gold);
      background: linear-gradient(180deg, rgba(201,169,97,0.06), transparent);
      border-radius: var(--radius);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      align-items: center;
    }
    .nf-inline-cta-wrap :global(.post-cta-inline p) {
      margin: 0;
      font-family: var(--font-jp);
      color: var(--ink);
      font-size: 0.92rem;
      line-height: 1.85;
      letter-spacing: 0.04em;
    }
    .nf-inline-cta-wrap :global(.post-cta-inline strong) {
      color: var(--gold-bright);
      font-weight: 600;
    }
    .nf-inline-cta-wrap :global(.post-cta-inline a) {
      display: inline-flex;
      align-items: center;
      padding: 12px 22px;
      background: var(--gold);
      color: var(--bg-deep);
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.16em;
      font-size: 0.88rem;
      white-space: nowrap;
      transition: background 0.3s var(--ease-luxe), transform 0.4s var(--ease-luxe);
    }
    .nf-inline-cta-wrap :global(.post-cta-inline a:hover) {
      background: var(--gold-bright);
      transform: translateY(-2px);
    }
    @media (max-width: 600px) {
      .nf-inline-cta-wrap :global(.post-cta-inline) {
        grid-template-columns: 1fr;
        text-align: center;
      }
      .nf-inline-cta-wrap :global(.post-cta-inline a) { justify-self: center; }
    }

    .nf-final-cta {
      max-width: 720px;
      margin: 0 auto;
      text-align: center;
    }
    .nf-final-lead {
      color: var(--ink-muted);
      line-height: 2;
      margin: 0 0 32px;
    }
    .nf-final-lead strong { color: var(--gold-bright); font-weight: 600; }
    .nf-final-cta-row {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      justify-content: center;
    }

    /* Reuse existing site-wide btn class so cinematic styles match */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 32px;
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.16em;
      font-size: 0.95rem;
      transition: background 0.3s var(--ease-luxe), color 0.3s var(--ease-luxe), border-color 0.3s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.4s var(--ease-luxe);
      cursor: pointer;
      border: 1px solid transparent;
      position: relative;
      overflow: hidden;
    }
    .btn-primary {
      background: var(--gold);
      color: var(--bg-deep);
      border-color: var(--gold);
    }
    .btn-primary:hover {
      background: var(--gold-bright);
      border-color: var(--gold-bright);
      box-shadow: 0 8px 32px -10px rgba(232,200,120,0.7);
    }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--ink-dim);
    }
    .btn-ghost:hover { color: var(--gold-bright); border-color: var(--gold); }

    .section { padding: 80px 0; }
    .section-dark {
      background: var(--bg-deep);
      border-top: 1px solid var(--film-edge);
      border-bottom: 1px solid var(--film-edge);
    }
    @media (max-width: 900px) { .section { padding: 60px 0; } }
  </style>
</Layout>
