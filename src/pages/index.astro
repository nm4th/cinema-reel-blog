---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { resolvePostThumbnail } from '../lib/post.ts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

const heroImg = 'https://cdnspacemarket.com/uploads/attachments/1571410/image.jpg?width=1600&quality=85&format=jpg&auto=webp';
const wideImg = 'https://cdnspacemarket.com/uploads/attachments/1585361/image.jpg?width=1600&quality=85&format=jpg&auto=webp';

const sceneImg = (n: string) => `/images/blog/home-scenes/${n}.png`;

const bookingSteps = [
  {
    num: '01',
    title: 'スペースマーケットで空き確認',
    body: '日付と時間を選択。リアルタイムで空きが見えます。所要 30秒。',
  },
  {
    num: '02',
    title: 'プランを選んで予約確定',
    body: '平日朝昼割（¥300/h〜）/ 平日通常 / 土日祝。料金は最終確認後の決済。',
  },
  {
    num: '03',
    title: '確認メールを受け取る',
    body: '当日の入室方法と鍵の場所をスペースマーケット経由で受信。',
  },
  {
    num: '04',
    title: '当日、新宿駅西口から徒歩2分',
    body: '大江戸線新宿西口駅 D5出口なら徒歩1分。地下通路から雨でも濡れずに来店可。',
  },
  {
    num: '05',
    title: 'キーボックスを開けて入室、すぐ大画面',
    body: 'VODはログイン済み。スマホからHDMIで自分の動画を映すのも自由。',
  },
];

const faqs = [
  {
    q: '予約時間より前に入室できますか？',
    a: 'いいえ、入室は予約開始時刻からです。装飾やセットアップが必要な場合は、その時間も含めて予約をお取りください（30〜60分の余裕を推奨）。',
  },
  {
    q: '声を出してライブ映像を観られますか？',
    a: '完全貸切ですが、近隣への配慮から「大声で叫ぶ・拍手・合唱・スピーカーで大音量」は禁止です。ペンライトを掲げる・小声で言葉を交わす・推しグッズを持ち寄って撮影、というスタイルでお楽しみください。',
  },
  {
    q: '飲食物の持ち込みはできますか？',
    a: '可能です。冷蔵庫・電子レンジ・電気ケトルあり。ただし匂いの強い食品（焼肉・カレー・香辛料の強い料理）は持ち込み禁止、ゴミは全て持ち帰りでお願いしています。',
  },
  {
    q: '何人まで利用できますか？',
    a: '最大6名です。基本料金内に追加料金なし、人数追加課金もありません。約19㎡（12畳）の空間に6名でちょうど密度高く楽しめるサイズ感です。',
  },
  {
    q: 'どんなVODが観られますか？',
    a: 'Netflix・Prime Video・U-NEXT・Disney+・Abema が店舗側でログイン済みです。ゲストはアカウント情報を入力する必要なく、来店してすぐ大画面で再生できます。YouTubeはご自身のアカウントでログインしてご利用ください。',
  },
  {
    q: '商用撮影や配信に使えますか？',
    a: 'はい、商用撮影オプション（+¥2,200/h）でご利用いただけます。シックな内装の個室で、配信・収録の用途にも適しています（建物の構造上、完全防音ではありませんので、大音量を出す撮影の際はオーナーへ事前にご相談ください）。',
  },
  {
    q: 'キャンセルはできますか？',
    a: 'スペースマーケット規定のキャンセルポリシーが適用されます。利用日からの日数に応じてキャンセル料の発生比率が決まっています。日程変更も同じ扱いになるので、早めにご連絡ください。',
  },
];

const vodServices = [
  {
    name: 'Netflix',
    logo: '/vod-logos/netflix.jpg',
    note: 'オリジナルドラマ・映画・アニメ',
    brandColor: '#e50914',
  },
  {
    name: 'Prime Video',
    logo: '/vod-logos/prime-video.png',
    note: '映画・スポーツ・PPV',
    brandColor: '#00a8e1',
  },
  {
    name: 'U-NEXT',
    logo: '/vod-logos/u-next.jpg',
    note: '邦画・洋画・アニメ・ライブ映像',
    brandColor: '#ffffff',
  },
  {
    name: 'Disney+',
    logo: '/vod-logos/disney-plus.jpg',
    note: 'ディズニー / ピクサー / マーベル / SW',
    brandColor: '#0c2461',
  },
  {
    name: 'ABEMA',
    logo: '/vod-logos/abema.svg',
    note: 'スポーツ生中継 / ニュース / バラエティ',
    brandColor: '#00d264',
  },
];

const venuePhotos = [
  {
    src: 'https://cdnspacemarket.com/uploads/attachments/1571410/image.jpg?width=900&quality=85&format=jpg&auto=webp',
    caption: 'スクリーン正面',
  },
  {
    src: 'https://cdnspacemarket.com/uploads/attachments/1556569/image.jpg?width=900&quality=85&format=jpg&auto=webp',
    caption: '室内・ソファ',
  },
  {
    src: 'https://cdnspacemarket.com/uploads/attachments/1529635/image.jpg?width=900&quality=85&format=jpg&auto=webp',
    caption: '4Kプロジェクター',
  },
  {
    src: 'https://cdnspacemarket.com/uploads/attachments/1585361/image.jpg?width=900&quality=85&format=jpg&auto=webp',
    caption: '空間全景',
  },
];
---
<Layout
  faqs={faqs}
  howto={{
    name: 'CINEMA REEL 新宿の予約方法',
    description: '新宿駅徒歩2分のプライベートシネマ「CINEMA REEL 新宿」を予約してご利用いただくまでの流れ。',
    steps: bookingSteps.map((s) => ({ name: s.title, text: s.body })),
  }}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url('${heroImg}');`}></div>
    <div class="hero-tint"></div>
    <div class="hero-spotlight" aria-hidden="true"></div>
    <div class="film-strip film-strip-left" aria-hidden="true">
      {Array.from({ length: 14 }).map(() => <span></span>)}
    </div>
    <div class="film-strip film-strip-right" aria-hidden="true">
      {Array.from({ length: 14 }).map(() => <span></span>)}
    </div>

    <div class="container hero-inner">
      <p class="hero-eyebrow stage-1">— Shinjuku · Private Cinema —</p>
      <h1 class="hero-title">
        <span class="hero-title-en stage-2">CINEMA</span>
        <span class="hero-title-en italic stage-3">REEL</span>
        <span class="hero-title-jp stage-4">新宿の、貸切のリール。</span>
      </h1>
      <p class="hero-lead stage-5">
        新宿駅徒歩2分・最大6名の完全貸切プライベートシネマ。<br />
        4Kプロジェクターと大画面で、誰にも邪魔されない時間を。
      </p>
      <div class="hero-meta stage-6">
        <span class="hero-meta-rating">
          <span class="hero-meta-star">★</span>
          <span data-count="4.6">4.6</span>
          <span class="hero-meta-rating-of">/ 5.0</span>
          <span class="hero-meta-rating-count">(<span data-count="43" data-count-suffix="件">43件</span>)</span>
        </span>
        <span class="dot">·</span>
        <span>最大6名 · 約19㎡</span>
        <span class="dot">·</span>
        <span>7:00 – 23:00</span>
      </div>
      <div class="hero-cta stage-7">
        <a class="btn btn-primary" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
          空き状況・予約
        </a>
        <a class="btn btn-ghost" href="#price">料金を見る</a>
      </div>
    </div>

    <a class="hero-scroll-cue" href="#about" aria-label="下にスクロール">
      <span></span>
    </a>
  </section>

  <!-- ABOUT / 01 -->
  <section id="about" class="section">
    <div class="container section-grid">
      <div class="section-head reveal-up">
        <span class="reel-section-num">— 01 / About</span>
        <h2 class="section-title">
          ひと部屋まるごと、<br />映画館。
        </h2>
      </div>
      <div class="section-body reveal-up">
        <p>
          CINEMA REEL 新宿は、新宿駅西口から徒歩2分のレンタルシアター。
          約19㎡（12畳）の完全個室に、4Kプロジェクターと大型スクリーン、ふかふかのソファ。
          外の喧騒も、隣の話し声もない、自分たちだけのスクリーンが、ただそこにあります。
        </p>
        <p>
          Netflix・Prime Video・U-NEXT・Disney+・Abemaのアカウントは店舗側で契約済み。
          ゲストはログイン不要、来店してすぐ大画面で本編に入れます。
        </p>
        <ul class="bullets">
          <li>EPSON 4Kプロジェクター + 大型スクリーン</li>
          <li>各サブスクVOD ログイン済み（Netflix / Prime / U-NEXT / Disney+ / Abema）</li>
          <li>冷蔵庫・電子レンジ・電気ケトル</li>
          <li>グラス・皿・カトラリー 各6セット</li>
          <li>新宿駅 徒歩2分 / 大江戸線新宿西口駅 徒歩1分</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- VOD SHOWCASE -->
  <section id="vod" class="section vod-showcase">
    <div class="container">
      <div class="section-head center reveal-up">
        <span class="reel-section-num">— Streaming</span>
        <h2 class="section-title">主要な動画配信サービス、<br />すべてログイン済み。</h2>
        <p class="section-sub">
          ご来店いただいたら、すぐに観たい作品を大画面で。
          ゲストはアカウント情報の入力不要、店舗側ですべて契約済み・ログイン済みの状態でお迎えします。
        </p>
      </div>

      <ul class="vod-grid stagger reveal-up">
        {vodServices.map((s) => (
          <li class="vod-card" data-service={s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')} style={`--brand: ${s.brandColor};`}>
            <div class="vod-logo-wrap">
              <img src={s.logo} alt={`${s.name} ロゴ`} loading="lazy" />
            </div>
            <p class="vod-name">{s.name}</p>
            <p class="vod-note">{s.note}</p>
          </li>
        ))}
      </ul>

      <p class="vod-foot">
        ※ YouTube はゲストご自身のアカウントでログインしてご利用ください。<br />
        ※ 各サービスのラインナップは予告なく変更される場合があります。
      </p>
    </div>
  </section>

  <!-- SCENES / 02 -->
  <section id="scenes" class="section section-dark">
    <div class="container">
      <div class="section-head center reveal-up">
        <span class="reel-section-num">— 02 / Scenes</span>
        <h2 class="section-title">
          こんなふうに、<br />使われています。
        </h2>
      </div>
      <div class="scenes-grid stagger reveal-up">
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('01-birthday')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>誕生日サプライズ</h3>
            <p>大画面のメッセージ動画と、ホールケーキの灯り。レストランでは作れない、貸切だけの瞬間を。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('02-oshikatsu')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>推し活・上映会</h3>
            <p>ライブ映像、出演ドラマ、推しのMV。ペンライトを掲げて、同担と「同じ瞬間」を共有する空間。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('03-date')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>デート / 記念日</h3>
            <p>ふたりだけのスクリーンで、思い出の映画をもう一度。記念日や、ちょっと特別にしたい日に。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('04-girls-night')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>女子会・パーティー</h3>
            <p>持ち込み自由、6人までゆったり。映画→おしゃべり→映画、と気分のままに。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('05-sports')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>スポーツ観戦</h3>
            <p>サッカー、野球、F1、格闘技。家のテレビでは出せない没入感を、新宿のど真ん中で。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('06-shoot')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>撮影 / 配信</h3>
            <p>商用撮影オプションあり。シックな内装で、配信・収録にも。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- VENUE GALLERY -->
  <section class="venue-gallery">
    <div class="container">
      <div class="section-head center reveal-up">
        <span class="reel-section-num">— Venue</span>
        <h2 class="section-title">この空間で、過ごす時間。</h2>
        <p class="section-sub">19㎡の完全個室・大型スクリーン・クリムゾンのソファ・4Kプロジェクター。</p>
      </div>
      <div class="venue-strip stagger">
        {venuePhotos.map((p) => (
          <figure class="venue-strip-item reveal-clip">
            <img src={p.src} alt={p.caption} loading="lazy" />
            <figcaption>{p.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- SOCIAL PROOF BANNER -->
  <section class="social-proof reveal-fade" aria-label="ご利用実績">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-item">
          <p class="proof-num">
            <span class="proof-star">★</span>
            <span data-count="4.6">4.6</span>
          </p>
          <p class="proof-label">スペースマーケット 評価平均</p>
        </div>
        <div class="proof-item">
          <p class="proof-num">
            <span data-count="43" data-count-suffix="">43</span><span class="proof-suffix">件</span>
          </p>
          <p class="proof-label">レビュー件数（執筆時点）</p>
        </div>
        <div class="proof-item">
          <p class="proof-num">
            <span data-count="2" data-count-suffix="">2</span><span class="proof-suffix">分</span>
          </p>
          <p class="proof-label">新宿駅西口から徒歩</p>
        </div>
        <div class="proof-item">
          <p class="proof-num">
            <span data-count="6" data-count-suffix="">6</span><span class="proof-suffix">名</span>
          </p>
          <p class="proof-label">最大収容（追加料金なし）</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURE PHOTO -->
  <section class="feature-photo">
    <div class="feature-photo-img" style={`background-image: url('${wideImg}');`}></div>
    <div class="feature-photo-overlay">
      <div class="container">
        <p class="reel-section-num">— Interlude</p>
        <p class="feature-photo-quote">
          「家でも、映画館でもない、<br />
          ちょうどいい暗さの居場所。」
        </p>
      </div>
    </div>
  </section>

  <!-- PRICE / 03 -->
  <section id="price" class="section">
    <div class="container">
      <div class="section-head reveal-up">
        <span class="reel-section-num">— 03 / Pricing</span>
        <h2 class="section-title">料金プラン</h2>
        <p class="section-sub">
          すべて1部屋あたりの料金（最大6名）。維持管理費 ¥2,000 / 利用 別途。
        </p>
      </div>
      <div class="price-grid stagger reveal-up">
        <div class="price-card">
          <p class="price-tag">平日 朝昼割</p>
          <p class="price-num"><span>¥</span>300<small>/h</small></p>
          <p class="price-cond">〜17:00 / 最低2時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">平日 通常</p>
          <p class="price-num"><span>¥</span>700<small>/h</small></p>
          <p class="price-cond">最低3時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">平日 長時間</p>
          <p class="price-num"><span>¥</span>650<small>/h</small></p>
          <p class="price-cond">最低5時間</p>
        </div>
        <div class="price-card hl">
          <p class="price-tag">土日祝</p>
          <p class="price-num"><span>¥</span>2,000<small>/h</small></p>
          <p class="price-cond">最低3時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">土日祝 長時間</p>
          <p class="price-num"><span>¥</span>1,900<small>/h</small></p>
          <p class="price-cond">最低5時間</p>
        </div>
        <div class="price-card subtle">
          <p class="price-tag">商用撮影</p>
          <p class="price-num"><span>¥</span>2,200<small>/h</small></p>
          <p class="price-cond">通常料金にオプション加算</p>
        </div>
      </div>
      <p class="price-note">
        ※ 表示はすべて税込目安。最新の正確な料金・空き状況はスペースマーケットの予約ページをご確認ください。
      </p>
    </div>
  </section>

  <!-- BOOKING FLOW / 04 -->
  <section id="booking-flow" class="section section-dark booking-flow-section">
    <div class="booking-flow-bg" aria-hidden="true"></div>
    <div class="container booking-flow-inner">
      <div class="section-head center reveal-up">
        <span class="reel-section-num">— 04 / How to Book</span>
        <h2 class="section-title">予約から、入室まで5分。</h2>
        <p class="section-sub">
          スペースマーケット経由で空き確認 → 予約 → 当日来店。鍵はキーボックスから自分で取り出すセルフチェックインです。
        </p>
      </div>

      <ol class="flow-list stagger reveal-up">
        {bookingSteps.map((s) => (
          <li class="flow-item">
            <div class="flow-num">{s.num}</div>
            <div class="flow-body">
              <h3 class="flow-title">{s.title}</h3>
              <p class="flow-text">{s.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="flow-cta reveal-fade">
        <a class="btn btn-primary" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
          スペースマーケットで空き確認
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ / 05 -->
  <section id="faq" class="section">
    <div class="container">
      <div class="section-head center reveal-up">
        <span class="reel-section-num">— 05 / FAQ</span>
        <h2 class="section-title">よくあるご質問</h2>
        <p class="section-sub">
          ご予約前に多く寄せられるご質問をまとめました。記載のないご質問は下記フォームからお問い合わせください。
        </p>
      </div>
      <div class="faq-wrap reveal-up">
        {faqs.map((f) => (
          <details class="faq-item">
            <summary>
              <span class="faq-q-mark">Q.</span>
              <span class="faq-q-text">{f.q}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <div class="faq-a">
              <span class="faq-a-mark">A.</span>
              <p>{f.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ACCESS / 06 -->
  <section id="access" class="section section-dark">
    <div class="container section-grid">
      <div class="section-head reveal-up">
        <span class="reel-section-num">— 06 / Access</span>
        <h2 class="section-title">
          新宿駅西口、<br />徒歩2分。
        </h2>
      </div>
      <div class="section-body reveal-up">
        <p>
          〒160-0023<br />
          東京都新宿区西新宿7-1-7
        </p>
        <ul class="bullets">
          <li>JR新宿駅 西口 徒歩2分</li>
          <li>都営大江戸線 新宿西口駅 D5出口 徒歩1分</li>
          <li>西武新宿駅 徒歩4分</li>
