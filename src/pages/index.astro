    .vod-card:hover::before { opacity: 1; }
    .vod-card-link {
      display: flex;
      flex-direction: column;
      width: 100%;
      padding: 28px 20px 22px;
      text-align: center;
    }
    .vod-logo-wrap {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }
    .vod-logo-wrap img {
      max-width: 100%;
      max-height: 64px;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 12px;
      transition: filter 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
      filter: brightness(0.95);
    }
    .vod-card:hover .vod-logo-wrap img {
      filter: brightness(1.1);
      transform: scale(1.04);
    }
    .vod-card[data-service="abema"] .vod-logo-wrap img {
      max-height: 36px;
      max-width: 90%;
      border-radius: 0;
      filter: brightness(1.05) invert(0.92);
    }
    .vod-card[data-service="abema"]:hover .vod-logo-wrap img {
      filter: brightness(1.2) invert(0.92);
    }
    .vod-name {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1.05rem;
      color: var(--ink);
      margin: 0 0 14px;
      padding-bottom: 12px;
      letter-spacing: 0.08em;
      border-bottom: 1px dashed var(--film-edge);
    }
    .vod-contents {
      list-style: none;
      padding: 0;
      margin: 0 0 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      flex: 1;
      text-align: left;
    }
    .vod-contents li {
      font-size: 0.76rem;
      line-height: 1.55;
      color: var(--ink-muted);
      padding-left: 12px;
      position: relative;
      font-family: var(--font-jp);
      letter-spacing: 0.02em;
    }
    .vod-contents li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--brand);
    }
    .vod-card-cta {
      margin: 0;
      font-family: var(--font-aux);
      font-style: italic;
      font-size: 0.78rem;
      color: var(--gold-bright);
      letter-spacing: 0.12em;
      text-align: right;
      transition: transform 0.4s var(--ease-luxe);
    }
    .vod-card:hover .vod-card-cta { transform: translateX(4px); }
    .vod-foot {
      margin: 32px 0 0;
      text-align: center;
      color: var(--ink-dim);
      font-size: 0.78rem;
      line-height: 1.9;
      letter-spacing: 0.04em;
    }

    /* ─── SCENES ─────────────────────────────────────────────── */
    .scenes { padding: 80px 0; }
    .scenes-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 14px;
      margin-top: 48px;
    }
    @media (max-width: 1100px) { .scenes-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 600px)  { .scenes-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
    .scene-card {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.5s var(--ease-luxe);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .scene-card:hover {
      border-color: var(--gold);
      transform: translateY(-3px);
      box-shadow: 0 14px 36px -16px rgba(201,169,97,0.25);
    }
    .scene-card-img {
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--bg-deep);
      transition: transform 0.6s var(--ease-luxe);
      filter: brightness(0.9);
    }
    .scene-card:hover .scene-card-img { transform: scale(1.04); filter: brightness(1); }
    .scene-card-body { padding: 14px 14px 18px; text-align: center; }
    .scene-card h3 {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--ink);
      margin: 0 0 6px;
      letter-spacing: 0.04em;
    }
    .scene-card p {
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.74rem;
      line-height: 1.55;
    }

    /* ─── THIS SPACE (split) ─────────────────────────────────── */
    .space { padding: 80px 0; background: var(--bg); }
    .space-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr 0.5fr;
      gap: 32px;
      align-items: start;
    }
    @media (max-width: 1000px) {
      .space-grid { grid-template-columns: 1fr; gap: 24px; }
    }
    .space-photo {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: var(--radius);
      border: 1px solid var(--film-edge);
    }
    .space-photo img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .space-content .section-title { text-align: left; margin: 0 0 24px; }
    .space-features {
      list-style: none;
      padding: 0;
      margin: 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
    }
    .space-features li {
      display: grid;
      grid-template-columns: 36px 1fr;
      gap: 14px;
      align-items: start;
    }
    .space-feature-icon {
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold-bright);
    }
    .space-feature-icon svg { width: 28px; height: 28px; }
    .space-features h3 {
      font-family: var(--font-jp);
      font-weight: 700;
      color: var(--ink);
      font-size: 0.95rem;
      margin: 0 0 4px;
      letter-spacing: 0.04em;
    }
    .space-features p {
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.82rem;
      line-height: 1.7;
    }
    .space-gallery {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    @media (max-width: 1000px) {
      .space-gallery { flex-direction: row; }
    }
    .gallery-thumb {
      flex: 1;
      aspect-ratio: 4 / 3;
      background-size: cover;
      background-position: center;
      background-color: var(--bg-deep);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
      display: block;
    }
    .gallery-thumb:hover { border-color: var(--gold); transform: translateY(-2px); }

    /* ─── PRICE (3 cards) ────────────────────────────────────── */
    .price { padding: 80px 0; background: var(--bg); }
    .price-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
      margin-top: 48px;
    }
    @media (max-width: 700px) { .price-grid { grid-template-columns: 1fr; } }
    .price-card {
      position: relative;
      padding: 32px 28px 28px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
    }
    .price-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .price-card.hl {
      background: linear-gradient(180deg, rgba(139,26,26,0.18), var(--bg-card));
      border-color: var(--crimson);
    }
    .price-card.hl:hover { border-color: var(--crimson-bright); }
    .price-tag {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--ink);
      letter-spacing: 0.06em;
      margin: 0 0 6px;
    }
    .price-card.hl .price-tag { color: var(--ink); }
    .price-cond {
      margin: 0 0 18px;
      color: var(--ink-muted);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }
    .price-amount {
      display: flex;
      align-items: baseline;
      gap: 4px;
      color: var(--ink);
    }
    .price-currency {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--gold-bright);
      font-size: 1.5rem;
    }
    .price-card.hl .price-currency { color: var(--crimson-bright); }
    .price-value {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: 2.6rem;
      color: var(--ink);
      line-height: 1;
    }
    .price-unit {
      color: var(--ink-muted);
      font-size: 0.85rem;
      margin-left: 4px;
    }
    .price-icon {
      position: absolute;
      top: 28px;
      right: 24px;
      font-size: 1.2rem;
      color: var(--gold);
      opacity: 0.7;
    }
    .price-note {
      margin: 32px 0 0;
      text-align: center;
      color: var(--ink-dim);
      font-size: 0.85rem;
    }

    /* ─── BOOKING FLOW (5 steps) ─────────────────────────────── */
    .booking-flow { padding: 80px 0; }
    .flow-list {
      list-style: none;
      padding: 0;
      margin: 48px 0 0;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 16px;
      position: relative;
    }
    @media (max-width: 1000px) { .flow-list { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 600px)  { .flow-list { grid-template-columns: 1fr; } }
    .flow-item {
      padding: 28px 20px 24px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      text-align: center;
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
      position: relative;
    }
    .flow-item:hover { border-color: var(--gold); transform: translateY(-2px); }
    .flow-num {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--bg-deep);
      font-family: var(--font-display);
      font-weight: 600;
      font-style: italic;
      font-size: 0.95rem;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 14px;
    }
    .flow-icon {
      width: 40px;
      height: 40px;
      margin: 0 auto 12px;
      color: var(--gold-bright);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .flow-icon svg { width: 32px; height: 32px; }
    .flow-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 0.92rem;
      color: var(--ink);
      margin: 0 0 8px;
      letter-spacing: 0.04em;
    }
    .flow-text {
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.74rem;
      line-height: 1.65;
    }

    /* ─── REVIEWS ────────────────────────────────────────────── */
    .reviews { padding: 80px 0; background: var(--bg); }
    .reviews-headline {
      text-align: center;
      margin-bottom: 48px;
    }
    .reviews-rating {
      display: inline-flex;
      align-items: baseline;
      gap: 6px;
      font-family: var(--font-display);
      font-weight: 600;
      color: var(--ink);
      margin: 0;
    }
    .reviews-rating .star { color: var(--gold-bright); font-size: 2rem; }
    .reviews-rating > span:nth-child(2) {
      font-size: 3rem;
      letter-spacing: 0.02em;
      line-height: 1;
    }
    .reviews-of {
      color: var(--ink-muted);
      font-size: 1.2rem;
    }
    .reviews-meta {
      margin: 8px 0 8px;
      color: var(--ink-muted);
      font-size: 0.85rem;
      letter-spacing: 0.16em;
      font-family: var(--font-aux);
      font-style: italic;
    }
    .reviews-stars {
      margin: 0;
      color: var(--gold-bright);
      letter-spacing: 0.4em;
      font-size: 1.1rem;
    }
    .reviews-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }
    @media (max-width: 900px) { .reviews-grid { grid-template-columns: 1fr; } }
    .review-card {
      padding: 28px 26px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
    }
    .review-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .review-stars {
      margin: 0 0 14px;
      color: var(--gold-bright);
      letter-spacing: 0.3em;
      font-size: 0.95rem;
    }
    .review-quote {
      margin: 0 0 14px;
      color: var(--ink);
      line-height: 1.95;
      font-size: 0.92rem;
      font-family: var(--font-jp);
      letter-spacing: 0.02em;
    }
    .review-label {
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.78rem;
      font-family: var(--font-aux);
      font-style: italic;
      letter-spacing: 0.1em;
    }

    /* ─── ACCESS (with map) ──────────────────────────────────── */
    .access { padding: 80px 0; }
    .access-grid {
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 40px;
      align-items: stretch;
    }
    @media (max-width: 900px) { .access-grid { grid-template-columns: 1fr; } }
    .access-map {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius);
      overflow: hidden;
      border: 1px solid var(--film-edge);
      background: var(--bg-deep);
    }
    .access-map iframe {
      width: 100%;
      height: 100%;
      border: 0;
      display: block;
      filter: invert(0.92) hue-rotate(180deg) contrast(0.85) saturate(0.6);
    }
    .access-info { display: flex; flex-direction: column; }
    .access-info .section-title { text-align: left; margin: 0 0 24px; }
    .access-list {
      list-style: none;
      padding: 0;
      margin: 0 0 32px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .access-list li {
      display: flex;
      gap: 12px;
      align-items: center;
      color: var(--ink);
      font-size: 0.95rem;
      line-height: 1.7;
    }
    .access-icon { color: var(--gold-bright); font-size: 1.05rem; }
    .access-cta { align-self: flex-start; padding: 16px 36px; font-size: 1rem; }
    @media (max-width: 480px) { .access-cta { width: 100%; align-self: stretch; } }
    .access-foot {
      margin: 16px 0 0;
      color: var(--ink-muted);
      font-size: 0.78rem;
      letter-spacing: 0.04em;
    }

    /* ─── Section base ───────────────────────────────────────── */
    .section { padding: 80px 0; }
    .section-dark {
      background: var(--bg-deep);
      border-top: 1px solid var(--film-edge);
      border-bottom: 1px solid var(--film-edge);
    }
    @media (max-width: 900px) { .section { padding: 60px 0; } }

    .section-head { display: flex; flex-direction: column; gap: 8px; }
    .section-head.center { align-items: center; text-align: center; margin-bottom: 16px; }
    .section-head.between { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; gap: 24px; }
    @media (max-width: 700px) {
      .section-head.between { flex-direction: column; align-items: flex-start; }
    }
    .section-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.4rem, 2.8vw, 1.9rem);
      color: var(--ink);
      letter-spacing: 0.04em;
      line-height: 1.5;
      margin: 0;
    }
    .section-sub {
      color: var(--ink-muted);
      max-width: 720px;
      margin: 0;
      line-height: 1.85;
      font-size: 0.92rem;
    }

    /* ─── FAQ ───────────────────────────────────────────────── */
    .faq-wrap {
      max-width: 880px;
      margin: 48px auto 0;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .faq-item {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.3s var(--ease-luxe);
    }
    .faq-item[open] { border-color: var(--gold); }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 22px 26px;
      display: grid;
      grid-template-columns: 32px 1fr 32px;
      gap: 16px;
      align-items: center;
      font-family: var(--font-jp);
      font-weight: 700;
      color: var(--ink);
      font-size: 1rem;
      line-height: 1.6;
      letter-spacing: 0.04em;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { color: var(--gold-bright); }
    .faq-q-mark {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--gold);
      font-size: 1.2rem;
    }
    .faq-q-text { font-size: 0.96rem; }
    .faq-icon {
      width: 14px;
      height: 14px;
      position: relative;
      justify-self: end;
    }
    .faq-icon::before, .faq-icon::after {
      content: '';
      position: absolute;
      background: var(--gold);
      transition: transform 0.4s var(--ease-luxe), opacity 0.4s var(--ease-luxe);
    }
    .faq-icon::before { top: 50%; left: 0; right: 0; height: 1px; }
    .faq-icon::after { top: 0; bottom: 0; left: 50%; width: 1px; }
    .faq-item[open] .faq-icon::after { transform: scaleY(0); opacity: 0; }
    .faq-a {
      padding: 0 26px 24px 78px;
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 16px;
      align-items: start;
    }
    .faq-a-mark {
      grid-column: 1;
      margin-left: -46px;
      font-family: var(--font-display);
      font-style: italic;
      color: var(--crimson-bright);
      font-size: 1.2rem;
    }
    .faq-a p {
      margin: 0;
      grid-column: 2;
      color: var(--ink-muted);
      line-height: 1.95;
      font-size: 0.93rem;
    }
    @media (max-width: 600px) {
      .faq-item summary { padding: 18px 18px; grid-template-columns: 28px 1fr 24px; gap: 12px; }
      .faq-a { padding: 0 18px 20px 18px; grid-template-columns: 1fr; }
      .faq-a-mark { margin-left: 0; grid-column: 1; }
      .faq-a p { grid-column: 1; }
    }

    /* ─── LINE callout band ─────────────────────────────────── */
    .line-band {
      padding: 64px 0;
      background:
        linear-gradient(180deg, rgba(6,199,85,0.08), rgba(6,199,85,0.02)),
        var(--bg);
      border-top: 1px solid rgba(6, 199, 85, 0.18);
      border-bottom: 1px solid rgba(6, 199, 85, 0.18);
    }
    .line-band-inner {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 40px;
      align-items: center;
    }
    @media (max-width: 800px) {
      .line-band-inner { grid-template-columns: 1fr; gap: 24px; text-align: left; }
    }
    .line-band-text { min-width: 0; }
    .line-band-eyebrow {
      display: inline-block;
      font-family: var(--font-aux), serif;
      letter-spacing: 0.24em;
      font-size: 0.72rem;
      color: #06C755;
      margin: 0 0 12px;
      padding: 5px 12px;
      border: 1px solid rgba(6, 199, 85, 0.5);
      border-radius: 999px;
      background: rgba(6, 199, 85, 0.08);
    }
    .line-band-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.2rem, 2.4vw, 1.6rem);
      color: var(--ink);
      letter-spacing: 0.04em;
      line-height: 1.55;
      margin: 0 0 14px;
    }
    .line-band-sub {
      margin: 0;
      color: var(--ink-muted);
      font-size: 0.88rem;
      line-height: 1.85;
      letter-spacing: 0.02em;
    }
    .line-band-cta {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 18px 32px;
      background: #06C755;
      color: #fff;
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 1rem;
      letter-spacing: 0.08em;
      border-radius: var(--radius);
      white-space: nowrap;
      transition: background 0.25s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.4s var(--ease-luxe);
      flex-shrink: 0;
    }
    .line-band-cta:hover {
      background: #07e063;
      transform: translateY(-2px);
      box-shadow: 0 12px 32px -10px rgba(6, 199, 85, 0.55);
    }
    .line-band-cta svg { flex-shrink: 0; }
    @media (max-width: 800px) {
      .line-band-cta { align-self: flex-start; padding: 16px 28px; font-size: 0.95rem; }
    }
    @media (max-width: 480px) {
      .line-band-cta { width: 100%; justify-content: center; }
    }

    /* ─── BLOG ──────────────────────────────────────────────── */
    .more-link {
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.14em;
      color: var(--gold-bright);
      font-size: 0.95rem;
    }
    .blog-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    @media (max-width: 900px) { .blog-grid { grid-template-columns: 1fr; } }
    .blog-card {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
    }
    .blog-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .blog-card-img {
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
    }
    .blog-card-body { padding: 22px 24px 24px; }
    .blog-card-meta {
      font-family: var(--font-aux);
      letter-spacing: 0.16em;
