    .blog-card {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.3s, transform 0.3s;
      display: flex;
      flex-direction: column;
    }
    .blog-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .blog-card-img {
      aspect-ratio: 16 / 9;
      background-size: cover;
      background-position: center;
    }
    .blog-card-body { padding: 24px; }
    .blog-card-meta {
      font-family: var(--font-aux);
      letter-spacing: 0.16em;
      color: var(--ink-muted);
      font-size: 0.8rem;
      margin: 0 0 12px;
      display: flex;
      gap: 10px;
      align-items: center;
    }
    .blog-card-meta .dot { color: var(--ink-dim); }
    .blog-card-title {
      font-family: var(--font-jp);
      font-weight: 700;
      color: var(--ink);
      font-size: 1.1rem;
      line-height: 1.5;
      margin: 0 0 12px;
      letter-spacing: 0.04em;
    }
    .blog-card-desc {
      color: var(--ink-muted);
