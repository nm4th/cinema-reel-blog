      background-position: center;
      background-color: var(--bg-deep);
      filter: brightness(0.18) saturate(0.9);
      z-index: 0;
    }
    .booking-flow-inner { position: relative; z-index: 1; }

    /* VOD SHOWCASE */
    .vod-showcase { padding: 96px 0; }
    .vod-grid {
      list-style: none;
      padding: 0;
      margin: 56px 0 32px;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 18px;
    }
    @media (max-width: 900px) { .vod-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 600px) { .vod-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }

    .vod-card {
      --brand: var(--gold);
      position: relative;
      padding: 28px 18px 22px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      text-align: center;
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.5s var(--ease-luxe);
      overflow: hidden;
    }
    .vod-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: var(--brand);
      opacity: 0;
      transition: opacity 0.4s var(--ease-luxe);
    }
    .vod-card:hover {
      border-color: var(--brand);
      transform: translateY(-4px);
      box-shadow: 0 14px 40px -16px color-mix(in srgb, var(--brand) 50%, transparent);
    }
    .vod-card:hover::before { opacity: 1; }
    .vod-logo-wrap {
      height: 72px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
    }
    .vod-logo-wrap img {
      max-width: 100%;
      max-height: 64px;
      width: auto;
      height: auto;
      object-fit: contain;
      border-radius: 12px;
      transition: filter 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe);
      filter: brightness(0.95);
    }
    .vod-card:hover .vod-logo-wrap img {
      filter: brightness(1.1);
      transform: scale(1.04);
    }
    /* ABEMA is a horizontal wordmark, not a square app icon — give it
       wider room and remove the rounded-square treatment. */
    .vod-card[data-service="abema"] .vod-logo-wrap img {
      max-height: 36px;
      max-width: 90%;
      border-radius: 0;
      filter: brightness(1.05) invert(0.92);
    }
    .vod-card[data-service="abema"]:hover .vod-logo-wrap img {
      filter: brightness(1.2) invert(0.92);
    }
    .vod-name {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 1rem;
      color: var(--ink);
      margin: 0 0 6px;
      letter-spacing: 0.08em;
    }
    .vod-note {
      margin: 0;
      font-size: 0.72rem;
      color: var(--ink-muted);
      letter-spacing: 0.04em;
      line-height: 1.5;
      font-family: var(--font-jp);
    }
    .vod-foot {
      margin: 32px 0 0;
      text-align: center;
      color: var(--ink-dim);
      font-size: 0.78rem;
      line-height: 1.9;
      letter-spacing: 0.04em;
    }

    /* SOCIAL PROOF banner */
    .social-proof {
      padding: 64px 0;
      background: linear-gradient(180deg, var(--bg) 0%, var(--bg-deep) 50%, var(--bg) 100%);
      border-top: 1px solid var(--film-edge);
      border-bottom: 1px solid var(--film-edge);
    }
    .proof-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 32px;
      align-items: end;
    }
    @media (max-width: 700px) {
      .proof-grid { grid-template-columns: repeat(2, 1fr); gap: 32px 24px; }
    }
    .proof-item { text-align: center; }
    .proof-num {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5vw, 3.4rem);
      font-weight: 600;
      color: var(--gold-bright);
      margin: 0 0 8px;
      line-height: 1;
      letter-spacing: 0.02em;
    }
    .proof-star { color: var(--gold-bright); margin-right: 6px; }
    .proof-suffix {
      font-size: 0.55em;
      color: var(--ink-muted);
      font-style: italic;
      margin-left: 6px;
      letter-spacing: 0.1em;
    }
    .proof-label {
      margin: 0;
      font-family: var(--font-aux);
      font-style: italic;
      letter-spacing: 0.16em;
      color: var(--ink-muted);
      font-size: 0.85rem;
    }

    /* BOOKING FLOW timeline */
    .flow-list {
      list-style: none;
      padding: 0;
      margin: 56px 0 48px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      max-width: 880px;
      margin-left: auto;
      margin-right: auto;
      counter-reset: flow;
    }
    .flow-item {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: 32px;
      align-items: start;
      padding: 28px 32px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      position: relative;
      transition: border-color 0.4s var(--ease-luxe), transform 0.4s var(--ease-luxe), box-shadow 0.4s var(--ease-luxe);
    }
    .flow-item:hover {
      border-color: var(--gold);
      transform: translateY(-2px);
      box-shadow: 0 14px 36px -16px rgba(201,169,97,0.25);
    }
    @media (max-width: 700px) {
      .flow-item { grid-template-columns: 1fr; gap: 12px; padding: 24px 22px; }
    }
    .flow-num {
      font-family: var(--font-display);
      font-style: italic;
      font-size: 2.6rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: 0.04em;
      line-height: 1;
    }
    .flow-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--ink);
      margin: 0 0 10px;
      letter-spacing: 0.04em;
    }
    .flow-text {
      margin: 0;
      color: var(--ink-muted);
      line-height: 1.9;
      font-size: 0.95rem;
    }
    .flow-cta { text-align: center; margin-top: 8px; }

    /* FAQ accordion */
    .faq-wrap {
      max-width: 880px;
      margin: 56px auto 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .faq-item {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      overflow: hidden;
      transition: border-color 0.3s var(--ease-luxe);
    }
    .faq-item[open] { border-color: var(--gold); }
    .faq-item summary {
      list-style: none;
      cursor: pointer;
      padding: 22px 26px;
      display: grid;
      grid-template-columns: 32px 1fr 32px;
      gap: 16px;
      align-items: center;
      font-family: var(--font-jp);
      font-weight: 700;
      color: var(--ink);
      font-size: 1.02rem;
      line-height: 1.6;
      letter-spacing: 0.04em;
      transition: color 0.3s var(--ease-luxe);
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { color: var(--gold-bright); }
    .faq-q-mark {
      font-family: var(--font-display);
      font-style: italic;
      color: var(--gold);
      font-size: 1.2rem;
    }
    .faq-q-text { font-size: 0.98rem; }
    .faq-icon {
      width: 14px;
      height: 14px;
      position: relative;
      justify-self: end;
    }
    .faq-icon::before,
    .faq-icon::after {
      content: '';
      position: absolute;
      background: var(--gold);
      transition: transform 0.4s var(--ease-luxe), opacity 0.4s var(--ease-luxe);
    }
    .faq-icon::before {
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
    }
    .faq-icon::after {
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
    }
    .faq-item[open] .faq-icon::after { transform: scaleY(0); opacity: 0; }
    .faq-a {
      padding: 0 26px 24px 78px;
      display: grid;
      grid-template-columns: 32px 1fr;
      gap: 16px;
      align-items: start;
      animation: faqOpen 0.5s var(--ease-luxe);
    }
    @keyframes faqOpen {
      from { opacity: 0; transform: translateY(-6px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .faq-a-mark {
      grid-column: 1;
      margin-left: -46px;
      font-family: var(--font-display);
      font-style: italic;
      color: var(--crimson-bright);
      font-size: 1.2rem;
    }
    .faq-a p {
      margin: 0;
      grid-column: 2;
      color: var(--ink-muted);
      line-height: 1.95;
      font-size: 0.95rem;
    }
    @media (max-width: 600px) {
      .faq-item summary { padding: 18px 18px; grid-template-columns: 28px 1fr 24px; gap: 12px; }
      .faq-a { padding: 0 18px 20px 18px; grid-template-columns: 1fr; }
      .faq-a-mark { margin-left: 0; grid-column: 1; }
      .faq-a p { grid-column: 1; }
    }

    .contact-form {
      max-width: 760px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }
    @media (max-width: 700px) { .form-row { grid-template-columns: 1fr; } }
    .contact-form label {
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-family: var(--font-jp);
      font-size: 0.85rem;
      color: var(--ink-muted);
      letter-spacing: 0.1em;
    }
    .contact-form label em {
      color: var(--crimson-bright);
      font-style: normal;
      margin-left: 4px;
    }
    .contact-form input,
    .contact-form select,
    .contact-form textarea {
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      color: var(--ink);
      padding: 12px 14px;
      font-family: var(--font-jp);
      font-size: 0.95rem;
      border-radius: var(--radius);
      transition: border-color 0.2s;
    }
    .contact-form input:focus,
    .contact-form select:focus,
    .contact-form textarea:focus {
      outline: none;
      border-color: var(--gold);
    }
    .form-block { display: flex; flex-direction: column; gap: 8px; }
    .form-foot {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
      margin-top: 8px;
    }
    .form-foot button { min-width: 240px; }
    .form-note {
      margin: 0;
      color: var(--ink-dim);
      font-size: 0.8rem;
      text-align: center;
      letter-spacing: 0.05em;
    }
    .form-note a { color: var(--gold-bright); border-bottom: 1px dashed var(--gold); }
  </style>
</Layout>
