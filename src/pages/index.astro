---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

const heroImg = 'https://cdnspacemarket.com/uploads/attachments/1571410/image.jpg?width=1600&quality=85&format=jpg&auto=webp';
const wideImg = 'https://cdnspacemarket.com/uploads/attachments/1585361/image.jpg?width=1600&quality=85&format=jpg&auto=webp';
---
<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url('${heroImg}');`}></div>
    <div class="hero-tint"></div>
    <div class="film-strip film-strip-left" aria-hidden="true">
      {Array.from({ length: 14 }).map(() => <span></span>)}
    </div>
    <div class="film-strip film-strip-right" aria-hidden="true">
      {Array.from({ length: 14 }).map(() => <span></span>)}
    </div>

    <div class="container hero-inner">
      <p class="hero-eyebrow">— Shinjuku · Private Cinema —</p>
      <h1 class="hero-title">
        <span class="hero-title-en">CINEMA</span>
        <span class="hero-title-en italic">REEL</span>
        <span class="hero-title-jp">新宿の、貸切のリール。</span>
      </h1>
      <p class="hero-lead">
        新宿駅徒歩2分。EPSON 4Kプロジェクターと大型スクリーンで、<br />
        映画も推し活も誕生日も、誰にも邪魔されない一夜に。
      </p>
      <div class="hero-meta">
        <span>★ 4.6 / 43件</span>
        <span class="dot">·</span>
        <span>最大6名 · 約19㎡</span>
        <span class="dot">·</span>
        <span>7:00 – 23:00</span>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
          空き状況・予約
        </a>
        <a class="btn btn-ghost" href="#price">料金を見る</a>
      </div>
    </div>
  </section>

  <!-- ABOUT / 01 -->
  <section id="about" class="section">
    <div class="container section-grid">
      <div class="section-head">
        <span class="reel-section-num">— 01 / About</span>
        <h2 class="section-title">
          ひと部屋まるごと、<br />映画館。
        </h2>
      </div>
      <div class="section-body">
        <p>
          CINEMA REEL 新宿は、新宿駅西口から徒歩2分のレンタルシアター。
          約19㎡（12畳）の完全個室に、4Kプロジェクターと大型スクリーン、ふかふかのソファ。
          外の喧騒も、隣の話し声もない、自分たちだけのスクリーンが、ただそこにあります。
        </p>
        <p>
          Netflix・Prime Video・U-NEXT・Disney+・Abemaのアカウントは店舗側で契約済み。
          ゲストはログイン不要、来店してすぐ大画面で本編に入れます。
        </p>
        <ul class="bullets">
          <li>EPSON 4Kプロジェクター + 大型スクリーン</li>
          <li>各サブスクVOD ログイン済み（Netflix / Prime / U-NEXT / Disney+ / Abema）</li>
          <li>Wi-Fi光回線・冷蔵庫・電子レンジ・電気ケトル</li>
          <li>グラス・皿・カトラリー 各6セット</li>
          <li>新宿駅 徒歩2分 / 大江戸線新宿西口駅 徒歩1分</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- SCENES / 02 -->
  <section id="scenes" class="section section-dark">
    <div class="container">
      <div class="section-head center">
        <span class="reel-section-num">— 02 / Scenes</span>
        <h2 class="section-title">
          こんな夜に、<br />使われています。
        </h2>
      </div>
      <div class="scenes-grid">
        <article class="scene-card">
          <h3>誕生日サプライズ</h3>
          <p>大画面のメッセージ動画と、ホールケーキの灯り。レストランでは作れない、貸切だけの瞬間を。</p>
        </article>
        <article class="scene-card">
          <h3>推し活・上映会</h3>
          <p>ライブ映像、出演ドラマ、推しのMV。ペンライトを振っても、声を出しても、誰も止めません。</p>
        </article>
        <article class="scene-card">
          <h3>デート / 記念日</h3>
          <p>ふたりだけのスクリーンで、思い出の映画をもう一度。終電を気にしない夜のために。</p>
        </article>
        <article class="scene-card">
          <h3>女子会・パーティー</h3>
          <p>持ち込み自由、6人までゆったり。映画→おしゃべり→映画、と気分のままに。</p>
        </article>
        <article class="scene-card">
          <h3>スポーツ観戦</h3>
          <p>サッカー、野球、F1、格闘技。家のテレビでは出せない没入感を、新宿のど真ん中で。</p>
        </article>
        <article class="scene-card">
          <h3>撮影 / 配信</h3>
          <p>商用撮影オプションあり。シックな内装と安定したWi-Fiで、配信・収録にも。</p>
        </article>
      </div>
    </div>
  </section>

  <!-- FEATURE PHOTO -->
  <section class="feature-photo">
    <div class="feature-photo-img" style={`background-image: url('${wideImg}');`}></div>
    <div class="feature-photo-overlay">
      <div class="container">
        <p class="reel-section-num">— Interlude</p>
        <p class="feature-photo-quote">
          「家でも、映画館でもない、<br />
          ちょうどいい暗さの居場所。」
        </p>
      </div>
    </div>
  </section>

  <!-- PRICE / 03 -->
  <section id="price" class="section">
    <div class="container">
      <div class="section-head">
        <span class="reel-section-num">— 03 / Pricing</span>
        <h2 class="section-title">料金プラン</h2>
        <p class="section-sub">
          すべて1部屋あたりの料金（最大6名）。維持管理費 ¥2,000 / 利用 別途。
        </p>
      </div>
      <div class="price-grid">
        <div class="price-card">
          <p class="price-tag">平日 朝昼割</p>
          <p class="price-num"><span>¥</span>300<small>/h</small></p>
          <p class="price-cond">〜17:00 / 最低2時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">平日 通常</p>
          <p class="price-num"><span>¥</span>700<small>/h</small></p>
          <p class="price-cond">最低3時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">平日 長時間</p>
          <p class="price-num"><span>¥</span>650<small>/h</small></p>
          <p class="price-cond">最低5時間</p>
        </div>
        <div class="price-card hl">
          <p class="price-tag">土日祝</p>
          <p class="price-num"><span>¥</span>2,000<small>/h</small></p>
          <p class="price-cond">最低3時間</p>
        </div>
        <div class="price-card">
          <p class="price-tag">土日祝 長時間</p>
          <p class="price-num"><span>¥</span>1,900<small>/h</small></p>
          <p class="price-cond">最低5時間</p>
        </div>
        <div class="price-card subtle">
          <p class="price-tag">商用撮影</p>
          <p class="price-num"><span>¥</span>2,200<small>/h</small></p>
          <p class="price-cond">通常料金にオプション加算</p>
        </div>
      </div>
      <p class="price-note">
        ※ 表示はすべて税込目安。最新の正確な料金・空き状況はスペースマーケットの予約ページをご確認ください。
      </p>
    </div>
  </section>

  <!-- ACCESS / 04 -->
  <section id="access" class="section section-dark">
    <div class="container section-grid">
      <div class="section-head">
        <span class="reel-section-num">— 04 / Access</span>
        <h2 class="section-title">
          新宿駅西口、<br />徒歩2分。
        </h2>
      </div>
      <div class="section-body">
        <p>
          〒160-0023<br />
          東京都新宿区西新宿7-1-7
        </p>
        <ul class="bullets">
          <li>JR新宿駅 西口 徒歩2分</li>
          <li>都営大江戸線 新宿西口駅 D5出口 徒歩1分</li>
          <li>西武新宿駅 徒歩4分</li>
          <li>新宿駅は他に丸ノ内線・京王線・小田急線などからアクセス可</li>
        </ul>
        <a class="btn btn-ghost" href="https://www.google.com/maps/search/?api=1&query=35.6944776,139.6990748" target="_blank" rel="noopener noreferrer">
          Google Mapで開く
        </a>
      </div>
    </div>
  </section>

  <!-- BLOG / 05 -->
  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head between">
          <div>
            <span class="reel-section-num">— 05 / Journal</span>
            <h2 class="section-title">最新の記事</h2>
          </div>
          <a class="more-link" href="/blog/">ブログ一覧へ →</a>
        </div>
        <div class="blog-grid">
          {posts.map((post) => (
            <a class="blog-card" href={`/blog/${post.slug}/`}>
              {post.data.heroImage && (
                <div class="blog-card-img" style={`background-image: url('${post.data.heroImage}');`}></div>
              )}
              <div class="blog-card-body">
                <p class="blog-card-meta">
                  <span>{post.data.category}</span>
                  <span class="dot">·</span>
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
                </p>
                <h3 class="blog-card-title">{post.data.title}</h3>
                <p class="blog-card-desc">{post.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CONTACT / 06 -->
  <section id="contact" class="section section-dark">
    <div class="container">
      <div class="section-head center">
        <span class="reel-section-num">— 06 / Contact</span>
        <h2 class="section-title">お問い合わせ</h2>
        <p class="section-sub">
          ご予約・空き状況はスペースマーケットが最速です。<br />
          下記フォームは取材・商用撮影・法人利用・その他ご相談用です。
        </p>
      </div>

      <form class="contact-form" action="https://formspree.io/f/xqewogvj" method="POST">
        <div class="form-row">
          <label>
            <span>お名前 <em>*</em></span>
            <input type="text" name="name" required autocomplete="name" />
          </label>
          <label>
            <span>会社名 / 団体名</span>
            <input type="text" name="company" autocomplete="organization" />
          </label>
        </div>
        <div class="form-row">
          <label>
            <span>メールアドレス <em>*</em></span>
            <input type="email" name="email" required autocomplete="email" />
          </label>
          <label>
            <span>電話番号</span>
            <input type="tel" name="phone" autocomplete="tel" />
          </label>
        </div>
        <div class="form-row">
          <label>
            <span>お問い合わせ種別</span>
            <select name="type">
              <option>取材・メディア掲載</option>
              <option>商用撮影・配信利用</option>
              <option>法人での貸切利用</option>
              <option>長期・複数回利用</option>
              <option>その他</option>
            </select>
          </label>
          <label>
            <span>ご希望日（任意）</span>
            <input type="text" name="preferred_date" placeholder="例: 2026/05/20 18:00〜" />
          </label>
        </div>
        <label class="form-block">
          <span>内容 <em>*</em></span>
          <textarea name="message" rows="6" required></textarea>
        </label>
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <div class="form-foot">
          <button class="btn btn-primary" type="submit">送信する</button>
          <p class="form-note">
            ※ 通常のスペース予約・空き確認は
            <a href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">スペースマーケット</a>
            からお願いいたします。
          </p>
        </div>
      </form>
    </div>
  </section>

  <style>
    .hero {
      position: relative;
      min-height: 92vh;
      overflow: hidden;
      display: flex;
      align-items: center;
      border-bottom: 1px solid var(--film-edge);
    }
    .hero-bg {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: brightness(0.45) contrast(1.05) saturate(0.85);
      transform: scale(1.05);
      animation: flicker 7s infinite ease-in-out;
    }
    .hero-tint {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(5,4,3,0.5) 0%, rgba(5,4,3,0.85) 100%),
        radial-gradient(ellipse at 20% 30%, rgba(139,26,26,0.18), transparent 60%),
        radial-gradient(ellipse at 80% 80%, rgba(201,169,97,0.12), transparent 60%);
    }

    .film-strip {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-around;
      padding: 8px 0;
      background: var(--bg-deep);
      border-left: 1px solid var(--film-edge);
      border-right: 1px solid var(--film-edge);
      z-index: 2;
    }
    .film-strip-left { left: 0; }
    .film-strip-right { right: 0; }
    .film-strip span {
      display: block;
      width: 14px;
      height: 18px;
      margin: 0 auto;
      background: var(--bg);
      border: 1px solid var(--film-edge);
    }
    @media (max-width: 700px) {
      .film-strip { width: 18px; }
      .film-strip span { width: 8px; height: 12px; }
    }

    .hero-inner {
      position: relative;
      z-index: 3;
      padding: 80px 0;
      animation: flicker 9s infinite;
    }
    .hero-eyebrow {
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.4em;
      color: var(--gold);
      margin: 0 0 20px;
      font-size: 0.85rem;
    }
    .hero-title {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin: 0;
      line-height: 0.95;
    }
    .hero-title-en {
      font-family: var(--font-display);
      font-weight: 600;
      font-size: clamp(3rem, 9vw, 6.5rem);
      letter-spacing: 0.06em;
      color: var(--ink);
    }
    .hero-title-en.italic { font-style: italic; color: var(--gold-bright); }
    .hero-title-jp {
      font-family: var(--font-jp);
      font-weight: 500;
      font-size: clamp(0.95rem, 1.6vw, 1.15rem);
      letter-spacing: 0.4em;
      color: var(--ink-muted);
      margin-top: 24px;
    }
    .hero-lead {
      margin: 32px 0 24px;
      color: var(--ink);
      font-size: 1rem;
      line-height: 2;
      max-width: 640px;
    }
    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      color: var(--ink-muted);
      font-family: var(--font-aux);
      letter-spacing: 0.18em;
      font-size: 0.9rem;
      margin-bottom: 36px;
    }
    .hero-meta .dot { color: var(--ink-dim); }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 16px; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 32px;
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.16em;
      font-size: 0.95rem;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
      cursor: pointer;
      border: 1px solid transparent;
    }
    .btn-primary {
      background: var(--gold);
      color: var(--bg-deep);
      border-color: var(--gold);
    }
    .btn-primary:hover { background: var(--gold-bright); border-color: var(--gold-bright); color: var(--bg-deep); }
    .btn-ghost {
      background: transparent;
      color: var(--ink);
      border-color: var(--ink-dim);
    }
    .btn-ghost:hover { color: var(--gold-bright); border-color: var(--gold); }

    .section { padding: 96px 0; }
    .section-dark { background: var(--bg-deep); border-top: 1px solid var(--film-edge); border-bottom: 1px solid var(--film-edge); }

    .section-grid {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 64px;
      align-items: start;
    }
    @media (max-width: 900px) {
      .section-grid { grid-template-columns: 1fr; gap: 32px; }
      .section { padding: 72px 0; }
    }
    .section-head { display: flex; flex-direction: column; gap: 18px; }
    .section-head.center { align-items: center; text-align: center; margin-bottom: 56px; }
    .section-head.between { display: flex; flex-direction: row; justify-content: space-between; align-items: flex-end; margin-bottom: 40px; gap: 24px; }
    @media (max-width: 700px) {
      .section-head.between { flex-direction: column; align-items: flex-start; }
    }
    .section-title {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: clamp(1.7rem, 3.4vw, 2.4rem);
      color: var(--ink);
      letter-spacing: 0.04em;
      line-height: 1.4;
    }
    .section-sub {
      color: var(--ink-muted);
      max-width: 720px;
      margin: 0;
      line-height: 1.9;
    }
    .section-body p {
      margin: 0 0 18px;
      color: #ece1cb;
      line-height: 2;
    }
    .bullets {
      list-style: none;
      padding: 0;
      margin: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .bullets li {
      padding-left: 22px;
      position: relative;
      color: var(--ink);
    }
    .bullets li::before {
      content: '—';
      position: absolute;
      left: 0;
      color: var(--gold);
    }

    .scenes-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    @media (max-width: 900px) { .scenes-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .scenes-grid { grid-template-columns: 1fr; } }
    .scene-card {
      padding: 32px 28px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      transition: border-color 0.3s, transform 0.3s;
    }
    .scene-card:hover { border-color: var(--gold); transform: translateY(-2px); }
    .scene-card h3 {
      font-family: var(--font-jp);
      font-weight: 700;
      font-size: 1.15rem;
      color: var(--gold-bright);
      margin: 0 0 14px;
      letter-spacing: 0.05em;
    }
    .scene-card p { margin: 0; color: var(--ink-muted); line-height: 1.9; font-size: 0.95rem; }

    .feature-photo {
      position: relative;
      min-height: 380px;
      overflow: hidden;
    }
    .feature-photo-img {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      filter: brightness(0.4) saturate(0.85);
    }
    .feature-photo-overlay {
      position: relative;
      z-index: 2;
      min-height: 380px;
      display: flex;
      align-items: center;
      background: linear-gradient(180deg, rgba(5,4,3,0.5), rgba(5,4,3,0.5));
    }
    .feature-photo-quote {
      font-family: var(--font-jp);
      font-weight: 500;
      font-size: clamp(1.4rem, 3vw, 2rem);
      color: var(--ink);
      margin: 16px 0 0;
      line-height: 1.7;
      max-width: 720px;
    }

    .price-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 40px;
    }
    @media (max-width: 900px) { .price-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 600px) { .price-grid { grid-template-columns: 1fr; } }
    .price-card {
      padding: 32px 24px;
      background: var(--bg-card);
      border: 1px solid var(--film-edge);
      border-radius: var(--radius);
      text-align: center;
    }
    .price-card.hl { border-color: var(--gold); background: linear-gradient(180deg, rgba(201,169,97,0.06), var(--bg-card)); }
    .price-card.subtle { background: transparent; }
    .price-tag {
      font-family: var(--font-display);
      font-style: italic;
      letter-spacing: 0.14em;
      color: var(--gold);
      margin: 0 0 14px;
      font-size: 0.95rem;
    }
    .price-num {
      font-family: var(--font-display);
      font-size: 2.6rem;
      font-weight: 600;
      color: var(--ink);
      margin: 0;
      line-height: 1;
    }
    .price-num span {
      font-size: 1.4rem;
      color: var(--gold);
      font-style: italic;
      margin-right: 4px;
    }
    .price-num small {
      font-size: 0.95rem;
      color: var(--ink-muted);
      margin-left: 4px;
      font-weight: 400;
    }
    .price-cond {
      margin: 14px 0 0;
      font-size: 0.85rem;
      color: var(--ink-muted);
      letter-spacing: 0.1em;
    }
    .price-note {
      margin: 32px 0 0;
      text-align: center;
