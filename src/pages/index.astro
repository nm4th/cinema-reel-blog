---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { resolvePostThumbnail } from '../lib/post.ts';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);

const fmt = (d: Date) =>
  new Intl.DateTimeFormat('ja-JP', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);

const heroImg = 'https://cdnspacemarket.com/uploads/attachments/1571410/image.jpg?width=1600&quality=85&format=jpg&auto=webp';
const wideImg = 'https://cdnspacemarket.com/uploads/attachments/1585361/image.jpg?width=1600&quality=85&format=jpg&auto=webp';
const interiorImg = 'https://cdnspacemarket.com/uploads/attachments/1556569/image.jpg?width=1200&quality=85&format=jpg&auto=webp';
const equipImg = 'https://cdnspacemarket.com/uploads/attachments/1529635/image.jpg?width=1200&quality=85&format=jpg&auto=webp';
const panoImg = 'https://cdnspacemarket.com/uploads/attachments/1585361/image.jpg?width=1200&quality=85&format=jpg&auto=webp';

const sceneImg = (n: string) => `/images/blog/home-scenes/${n}.png`;

// 6つの特徴
const features = [
  {
    icon: 'lock',
    title: '完全貸切',
    body: '他のお客様と会うことのない、あなたたちだけのプライベート空間。',
  },
  {
    icon: 'play',
    title: 'すぐ観られる',
    body: '主要VODはログイン済み。来店後すぐに大画面で視聴可能。',
  },
  {
    icon: 'pin',
    title: '新宿駅徒歩2分',
    body: '新宿駅西口から徒歩2分の好立地。アクセス抜群で集合もスムーズ。',
  },
  {
    icon: 'people',
    title: '最大6名',
    body: 'ソファ＋クッションで最大6名まで。少人数でゆったり楽しめます。',
  },
  {
    icon: 'cup',
    title: '飲食持ち込みOK',
    body: 'お好きなフードやドリンクを持ち込み自由で楽しめます。',
  },
  {
    icon: 'sparkle',
    title: 'シックで映える空間',
    body: 'ダークトーン×レッドカーペットのシネマ空間で特別な時間を演出。',
  },
];

// 「この空間で、過ごす時間」セクション内の機能リスト
const spaceFeatures = [
  {
    icon: 'monitor',
    title: '大型スクリーン',
    body: '迫力の大画面で映画や映像を満喫。',
  },
  {
    icon: 'projector',
    title: '4Kプロジェクター',
    body: '高画質・高音質で没入感を体験。',
  },
  {
    icon: 'sofa',
    title: 'ふかふかソファ',
    body: 'ゆったりくつろげる快適ソファ。',
  },
  {
    icon: 'kitchen',
    title: '冷蔵庫・電子レンジ・ケトル完備',
    body: '長時間のご利用も快適で便利。',
  },
];

// レビュー（プレースホルダー — 実際のスペースマーケットレビューに差し替えてください）
const reviews = [
  {
    quote: '雰囲気がとても良かったです。デートで利用しました。照明やインテリアが落ち着いていて、映画に集中できました。',
    label: 'デート利用',
  },
  {
    quote: 'アクセスが抜群！新宿駅からすぐで集合も楽でした。設備も清潔で快適に過ごせました。',
    label: '友人グループ',
  },
  {
    quote: '推し活にぴったり！大画面でライブ鑑賞ができて満足です。また利用したいです。',
    label: '推し活上映会',
  },
];

const bookingSteps = [
  { num: '1', title: '空き確認', body: 'カレンダーで空き状況を確認' },
  { num: '2', title: '予約', body: '希望の日時で予約手続き' },
  { num: '3', title: '確認メール', body: '予約完了メールが届きます' },
  { num: '4', title: '来店', body: '時間になったらご来店ください' },
  { num: '5', title: 'セルフチェックイン', body: '入室方法をご案内、そのままご利用開始' },
];

const faqs = [
  {
    q: '予約時間より前に入室できますか？',
    a: 'いいえ、入室は予約開始時刻からです。装飾やセットアップが必要な場合は、その時間も含めて予約をお取りください（30〜60分の余裕を推奨）。',
  },
  {
    q: '声を出してライブ映像を観られますか？',
    a: '完全貸切ですが、近隣への配慮から「大声で叫ぶ・拍手・合唱・スピーカーで大音量」は禁止です。ペンライトを掲げる・小声で言葉を交わす・推しグッズを持ち寄って撮影、というスタイルでお楽しみください。',
  },
  {
    q: '飲食物の持ち込みはできますか？',
    a: '可能です。冷蔵庫・電子レンジ・電気ケトルあり。ただし匂いの強い食品（焼肉・カレー・香辛料の強い料理）は持ち込み禁止、ゴミは全て持ち帰りでお願いしています。',
  },
  {
    q: '何人まで利用できますか？',
    a: '最大6名です。基本料金内に追加料金なし、人数追加課金もありません。約19㎡（12畳）の空間に6名でちょうど密度高く楽しめるサイズ感です。',
  },
  {
    q: 'どんなVODが観られますか？',
    a: 'Netflix・Prime Video・U-NEXT・Disney+・Abema が店舗側でログイン済みです。ゲストはアカウント情報を入力する必要なく、来店してすぐ大画面で再生できます。YouTubeはご自身のアカウントでログインしてご利用ください。',
  },
  {
    q: '商用撮影や配信に使えますか？',
    a: 'はい、商用撮影オプション（+¥2,200/h）でご利用いただけます。シックな内装の個室で、配信・収録の用途にも適しています（建物の構造上、完全防音ではありませんので、大音量を出す撮影の際はオーナーへ事前にご相談ください）。',
  },
  {
    q: 'キャンセルはできますか？',
    a: 'スペースマーケット規定のキャンセルポリシーが適用されます。利用日からの日数に応じてキャンセル料の発生比率が決まっています。日程変更も同じ扱いになるので、早めにご連絡ください。',
  },
];

const vodServices = [
  {
    name: 'Netflix',
    slug: 'netflix',
    logo: '/vod-logos/netflix.jpg',
    brandColor: '#e50914',
    contents: [
      'Netflix オリジナルシリーズ・独占配信映画',
      '韓国ドラマ・邦画・洋画',
      'アニメ・ドキュメンタリー',
      'ライブ生中継(スポーツ・MMA等の一部)',
    ],
  },
  {
    name: 'Prime Video',
    slug: 'prime',
    logo: '/vod-logos/prime-video.png',
    brandColor: '#00a8e1',
    contents: [
      'Amazon オリジナルシリーズ',
      '海外ドラマ・映画',
      'スポーツ生中継(ボクシング・サッカー等)',
      '追加料金で観られる Prime Video チャンネル',
    ],
  },
  {
    name: 'U-NEXT',
    slug: 'u-next',
    logo: '/vod-logos/u-next.jpg',
    brandColor: '#ffffff',
    contents: [
      '邦画・洋画(最新作も配信)',
      'アニメ・韓ドラ',
      'アーティストのライブ映像(独占配信多数)',
      '雑誌読み放題機能つき',
    ],
  },
  {
    name: 'Disney+',
    slug: 'disney',
    logo: '/vod-logos/disney-plus.jpg',
    brandColor: '#0c2461',
    contents: [
      'ディズニー作品(クラシック〜最新)',
      'ピクサー / マーベル / スター・ウォーズ',
      'ナショナル ジオグラフィック',
      'Disney+ オリジナルシリーズ',
    ],
  },
  {
    name: 'ABEMA',
    slug: 'abema',
    logo: '/vod-logos/abema.svg',
    brandColor: '#00d264',
    contents: [
      'スポーツ生中継(ボクシング・サッカー・将棋等)',
      'PPV 格闘技(独占配信多数)',
      '恋愛リアリティショー・バラエティ',
      'AbemaNews 24時間配信',
    ],
  },
];
---
<Layout
  faqs={faqs}
  howto={{
    name: 'CINEMA REEL 新宿の予約方法',
    description: '新宿駅徒歩2分のプライベートシネマ「CINEMA REEL 新宿」を予約してご利用いただくまでの流れ。',
    steps: bookingSteps.map((s) => ({ name: s.title, text: s.body })),
  }}
>
  <!-- HERO (cinematic full-bleed) -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <img src={heroImg} alt="" loading="eager" />
      <div class="hero-veil"></div>
      <div class="hero-grain"></div>
    </div>
    <div class="container">
      <div class="hero-inner">
        <span class="hero-eyebrow">SHINJUKU · PRIVATE CINEMA</span>
        <h1 class="hero-title">
          新宿駅徒歩2分。<br />
          完全貸切の、<br />
          <em>プライベートシネマ。</em>
        </h1>
        <p class="hero-sub">
          最大6名 / 4Kプロジェクター / 主要VODログイン済み。<br />
          誰にも邪魔されない時間を。
        </p>
        <div class="hero-stats">
          <span class="stat-rating">
            <span class="star">★</span>
            <span data-count="4.6">4.6</span>
            <span class="of">/ 5.0</span>
          </span>
          <span class="dot">·</span>
          <span><span data-count="43" data-count-suffix="件">43件</span>レビュー</span>
          <span class="dot">·</span>
          <span class="stat-icon">⏰</span><span>7:00〜23:00</span>
          <span class="dot">·</span>
          <span>約19㎡</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-crimson" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer">
            空き状況・予約はこちら
          </a>
          <a class="btn btn-line" href="https://lin.ee/tw32ssM" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path fill="currentColor" d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.629-.63.346 0 .631.285.631.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
            <span>LINE で相談</span>
          </a>
          <a class="btn btn-ghost" href="#price">料金を見る</a>
        </div>
        <p class="hero-tags">
          デート・記念日・女子会・推し活・スポーツ観戦など、あらゆるシーンに最適。
        </p>
      </div>
    </div>
  </section>

  <!-- 6 FEATURES (icon grid) -->
  <section id="features" class="features">
    <div class="container">
      <header class="section-head reveal-up">
        <span class="eyebrow">FEATURES</span>
        <h2 class="section-title">なぜ、選ばれるのか</h2>
        <p class="section-lede">完全貸切のプライベートシネマだから叶う、6つの体験。</p>
      </header>
      <div class="features-grid stagger reveal-up">
        {features.map((f) => (
          <article class="feature-card">
            <div class="feature-icon" aria-hidden="true">
              {f.icon === 'lock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
              )}
              {f.icon === 'play' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M10 8.5l5 3.5-5 3.5z" fill="currentColor"/></svg>
              )}
              {f.icon === 'pin' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s7-7 7-12a7 7 0 1 0-14 0c0 5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
              )}
              {f.icon === 'people' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="9" cy="8" r="3"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><circle cx="17" cy="9" r="2.5"/><path d="M14.5 14.5c2.5 0 5 1.6 5 4.5"/></svg>
              )}
              {f.icon === 'cup' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 8h11v8a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4z"/><path d="M16 10h2a2.5 2.5 0 0 1 0 5h-2"/><path d="M8 4v2M11 4v2"/></svg>
              )}
              {f.icon === 'sparkle' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l1.8 5.4L19 10l-5.2 1.6L12 17l-1.8-5.4L5 10l5.2-1.6z" fill="currentColor" stroke="none"/><path d="M19 16l.8 2 2 .8-2 .8L19 22l-.8-2-2-.8 2-.8z" fill="currentColor" stroke="none"/></svg>
              )}
            </div>
            <div class="feature-text">
              <h3 class="feature-title">{f.title}</h3>
              <p class="feature-body">{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- VOD logo cards -->
  <section id="vod" class="vod-section">
    <div class="container">
      <div class="section-head center reveal-up">
        <h2 class="section-title">観たい作品に、すぐ没入。</h2>
        <p class="section-sub">主要VODはログイン済み。来店後すぐに大画面で楽しめます。</p>
      </div>
      <ul class="vod-grid stagger reveal-up">
        {vodServices.map((s) => (
          <li class="vod-card" data-service={s.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')} style={`--brand: ${s.brandColor};`}>
            <a href={`/${s.slug}/`} class="vod-card-link">
              <div class="vod-logo-wrap">
                <img src={s.logo} alt={`${s.name} ロゴ`} loading="lazy" />
              </div>
              <p class="vod-name">{s.name}</p>
              <ul class="vod-contents">
                {s.contents.map((c) => <li>{c}</li>)}
              </ul>
              <p class="vod-card-cta">特集ページを見る →</p>
            </a>
          </li>
        ))}
      </ul>
      <p class="vod-foot">
        ※ YouTube はゲストご自身のアカウントでログインしてご利用ください。<br />
        ※ 各サービスのラインナップは予告なく変更される場合があります。
      </p>
    </div>
  </section>

  <!-- SCENES (6 cards with images) -->
  <section id="scenes" class="scenes section-dark">
    <div class="container">
      <div class="section-head center reveal-up">
        <h2 class="section-title">さまざまなシーンで、ご利用いただけます。</h2>
      </div>
      <div class="scenes-grid stagger reveal-up">
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('03-date')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>デート / 記念日</h3>
            <p>二人だけの特別な時間に。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('02-oshikatsu')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>推し活・上映会</h3>
            <p>ライブ配信や上映会にも最適。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('04-girls-night')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>女子会・パーティー</h3>
            <p>持ち込み自由で盛り上がる。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('05-sports')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>スポーツ観戦</h3>
            <p>大迫力で臨場感たっぷり。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('01-birthday')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>誕生日サプライズ</h3>
            <p>サプライズ演出もお任せ。</p>
          </div>
        </article>
        <article class="scene-card">
          <div class="scene-card-img" style={`background-image: url('${sceneImg('06-shoot')}');`} aria-hidden="true"></div>
          <div class="scene-card-body">
            <h3>撮影・配信</h3>
            <p>動画撮影や配信にも対応。</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- THIS SPACE (split: photo + features + thumbnail gallery) -->
  <section id="space" class="space">
    <div class="container">
      <div class="space-grid reveal-up">
        <div class="space-photo">
          <img src={interiorImg} alt="CINEMA REEL 新宿の室内全景" loading="lazy" />
        </div>
        <div class="space-content">
          <h2 class="section-title">この空間で、過ごす時間。</h2>
          <ul class="space-features">
            {spaceFeatures.map((f) => (
              <li>
                <span class="space-feature-icon" aria-hidden="true">
                  {f.icon === 'monitor' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="4" width="18" height="13" rx="1.5"/><path d="M9 21h6M12 17v4"/></svg>
                  )}
                  {f.icon === 'projector' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="9" width="14" height="8" rx="1.5"/><circle cx="13" cy="13" r="2"/><path d="M17 12h4M19 14l2 2"/></svg>
                  )}
                  {f.icon === 'sofa' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12V8a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v4"/><path d="M3 14a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4H3z"/><path d="M5 18v2M19 18v2"/></svg>
                  )}
                  {f.icon === 'kitchen' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M4 11h16"/><circle cx="8" cy="7" r="0.5" fill="currentColor"/><circle cx="8" cy="16" r="0.5" fill="currentColor"/></svg>
                  )}
                </span>
                <div>
                  <h3>{f.title}</h3>
                  <p>{f.body}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div class="space-gallery">
          <a class="gallery-thumb" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer" style={`background-image: url('${heroImg}');`} aria-label="ギャラリー1"></a>
          <a class="gallery-thumb" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer" style={`background-image: url('${equipImg}');`} aria-label="ギャラリー2"></a>
          <a class="gallery-thumb" href="https://spacemarket.com/p/Rk36vVe7-ZK_fg-E" target="_blank" rel="noopener noreferrer" style={`background-image: url('${panoImg}');`} aria-label="ギャラリー3"></a>
        </div>
      </div>
    </div>
